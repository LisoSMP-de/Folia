@@ -0,0 +1,53 @@
+package io.papermc.paper.threadedregions;
+
+import java.util.Arrays;
+
+/** Rolling per-chunk tick-time sampler, ported from Luminol's KioCG ChunkHot implementation. */
+public final class ChunkHot {
+    private static final int SAMPLE_WINDOWS = 10;
+    private static final long MAX_SAMPLE_NANOS = 1_000_000L;
+    private final long[] times = new long[SAMPLE_WINDOWS];
+    private int index = -1;
+    private long previous;
+    private long total;
+    private long startedAt;
+    private boolean sampling;
+    private int nesting;
+
+    public void nextWindow() {
+        this.index = (this.index + 1) % SAMPLE_WINDOWS;
+        this.previous = this.times[this.index];
+        this.times[this.index] = 0L;
+        this.sampling = true;
+    }
+
+    public void finishWindow() {
+        if (!this.sampling) return;
+        this.sampling = false;
+        this.nesting = 0;
+        this.total += this.times[this.index] - this.previous;
+    }
+
+    public void startTicking() {
+        if (!this.sampling || this.nesting++ != 0) return;
+        this.startedAt = System.nanoTime();
+    }
+
+    public void stopTickingAndCount() {
+        if (!this.sampling || this.nesting <= 0 || --this.nesting != 0) return;
+        this.times[this.index] += Math.min(System.nanoTime() - this.startedAt, MAX_SAMPLE_NANOS);
+    }
+
+    public void clear() {
+        this.sampling = false;
+        this.nesting = 0;
+        Arrays.fill(this.times, 0L);
+        this.previous = 0L;
+        this.total = 0L;
+        this.startedAt = 0L;
+    }
+
+    public long average() {
+        return this.total / (SAMPLE_WINDOWS * 20L);
+    }
+}
diff --git a/src/main/java/io/papermc/paper/threadedregions/FoliaStatusBarCommand.java b/src/main/java/io/papermc/paper/threadedregions/FoliaStatusBarCommand.java
new file mode 100644
index 000000000..0ef4cf983
--- /dev/null
+++ b/src/main/java/io/papermc/paper/threadedregions/FoliaStatusBarCommand.java
@@ -0,0 +1,351 @@
+package io.papermc.paper.threadedregions;
+
+import ca.spottedleaf.moonrise.common.time.TickData;
+import io.papermc.paper.threadedregions.scheduler.ScheduledTask;
+import java.lang.management.ManagementFactory;
+import java.lang.management.MemoryUsage;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+import net.kyori.adventure.text.minimessage.MiniMessage;
+import net.kyori.adventure.text.minimessage.tag.resolver.Placeholder;
+import net.kyori.adventure.bossbar.BossBar;
+import net.kyori.adventure.text.Component;
+import net.kyori.adventure.text.format.NamedTextColor;
+import org.bukkit.Bukkit;
+import org.bukkit.NamespacedKey;
+import org.bukkit.command.CommandSender;
+import org.bukkit.command.defaults.BukkitCommand;
+import org.bukkit.entity.Player;
+import org.bukkit.persistence.PersistentDataType;
+import org.bukkit.plugin.Plugin;
+import org.jetbrains.annotations.NotNull;
+
+/** Folia-native TPS, memory, and region status bars, ported from Luminol's bar patch. */
+public final class FoliaStatusBarCommand extends BukkitCommand {
+    private static final Plugin INTERNAL_PLUGIN = new FoliaStatusBarPlugin();
+    private static final Map<BarType, Map<UUID, BossBar>> BARS = new ConcurrentHashMap<>();
+    private static ScheduledTask scannerTask;
+    private final BarType fixedType;
+
+    public FoliaStatusBarCommand() {
+        super("bar", "Toggle Folia status bars", "/bar <tps|memory|region|cpu> [on|off|toggle]", List.of("statusbar"));
+        this.setPermission("folia.command.bar");
+        this.fixedType = null;
+        for (final BarType type : BarType.values()) {
+            BARS.put(type, new ConcurrentHashMap<>());
+        }
+    }
+
+    private FoliaStatusBarCommand(final String name, final BarType type) {
+        super(name, "Toggle the Folia " + name, "/" + name + " [on|off|toggle]", List.of());
+        this.setPermission("folia.command." + name);
+        this.fixedType = type;
+    }
+
+    public static FoliaStatusBarCommand tpsBarCommand() {
+        return new FoliaStatusBarCommand("tpsbar", BarType.TPS);
+    }
+
+    public static FoliaStatusBarCommand ramBarCommand() {
+        return new FoliaStatusBarCommand("rambar", BarType.MEMORY);
+    }
+
+    public static FoliaStatusBarCommand regionBarCommand() {
+        return new FoliaStatusBarCommand("regionbar", BarType.REGION);
+    }
+
+    public static FoliaStatusBarCommand cpuBarCommand() {
+        return new FoliaStatusBarCommand("cpubar", BarType.CPU);
+    }
+
+    public static synchronized void start() {
+        if (scannerTask != null && !scannerTask.isCancelled()) return;
+        scannerTask = Bukkit.getGlobalRegionScheduler().runAtFixedRate(INTERNAL_PLUGIN, task -> {
+            for (final Player player : Bukkit.getOnlinePlayers()) {
+                for (final BarType type : BarType.values()) {
+                    if (enabled(player, type) && !BARS.get(type).containsKey(player.getUniqueId())) {
+                        schedule(player, type);
+                    }
+                }
+            }
+        }, 1L, 20L);
+    }
+
+    public static synchronized void stop() {
+        if (scannerTask != null) scannerTask.cancel();
+        scannerTask = null;
+        for (final Map<UUID, BossBar> bars : BARS.values()) bars.clear();
+    }
+
+    @Override
+    public boolean execute(@NotNull CommandSender sender, @NotNull String label, @NotNull String[] args) {
+        if (!this.testPermission(sender)) return true;
+        if (!(sender instanceof Player player)) {
+            sender.sendMessage(Component.text("This command can only be used by a player.", NamedTextColor.RED));
+            return true;
+        }
+        if (this.fixedType == null && args.length == 0) {
+            sender.sendMessage(Component.text(this.getUsage(), NamedTextColor.YELLOW));
+            return true;
+        }
+        final BarType type;
+        if (this.fixedType != null) {
+            type = this.fixedType;
+        } else {
+            try {
+                type = BarType.valueOf(args[0].toUpperCase(Locale.ROOT));
+            } catch (final IllegalArgumentException ignored) {
+                sender.sendMessage(Component.text("Unknown bar. Use tps, memory, or region.", NamedTextColor.RED));
+                return true;
+            }
+        }
+        final boolean current = enabled(player, type);
+        final int actionIndex = this.fixedType == null ? 1 : 0;
+        final boolean value = args.length <= actionIndex || args[actionIndex].equalsIgnoreCase("toggle") ? !current : args[actionIndex].equalsIgnoreCase("on");
+        final net.minecraft.server.level.ServerPlayer handle = ((org.bukkit.craftbukkit.entity.CraftPlayer) player).getHandle();
+        switch (type) {
+            case TPS -> handle.tpsBarEnabled = value;
+            case MEMORY -> handle.memBarEnabled = value;
+            case REGION -> handle.regionBarEnabled = value;
+            case CPU -> handle.cpuBarEnabled = value;
+        }
+        if (value) {
+            schedule(player, type);
+        } else {
+            remove(player, type);
+        }
+        sender.sendMessage(Component.text(type.name().toLowerCase(Locale.ROOT) + " bar " + (value ? "enabled" : "disabled") + ".", NamedTextColor.GREEN));
+        return true;
+    }
+
+    @Override
+    public @NotNull List<String> tabComplete(@NotNull CommandSender sender, @NotNull String alias, @NotNull String[] args) {
+        final List<String> result = new ArrayList<>();
+        if (this.fixedType == null && args.length == 1) for (final BarType type : BarType.values()) result.add(type.name().toLowerCase(Locale.ROOT));
+        if ((this.fixedType == null && args.length == 2) || (this.fixedType != null && args.length == 1)) result.addAll(List.of("on", "off", "toggle"));
+        result.removeIf(value -> !value.startsWith(args[args.length - 1].toLowerCase(Locale.ROOT)));
+        return result;
+    }
+
+    private static boolean enabled(final Player player, final BarType type) {
+        final net.minecraft.server.level.ServerPlayer handle = ((org.bukkit.craftbukkit.entity.CraftPlayer) player).getHandle();
+        return switch (type) {
+            case TPS -> handle.tpsBarEnabled;
+            case MEMORY -> handle.memBarEnabled;
+            case REGION -> handle.regionBarEnabled;
+            case CPU -> handle.cpuBarEnabled;
+        };
+    }
+
+    private static void schedule(final Player player, final BarType type) {
+        final UUID uuid = player.getUniqueId();
+        final BossBar bar = BossBar.bossBar(Component.empty(), 0.0F, BossBar.Color.GREEN, BossBar.Overlay.NOTCHED_20);
+        if (BARS.get(type).putIfAbsent(uuid, bar) != null) return;
+        player.showBossBar(bar);
+        player.getScheduler().runAtFixedRate(INTERNAL_PLUGIN, task -> {
+            if (!player.isOnline() || !enabled(player, type)) {
+                task.cancel();
+                remove(player, type);
+                return;
+            }
+            update(player, type, bar);
+        }, () -> BARS.get(type).remove(uuid), 1L, 20L);
+    }
+
+    private static double lastProcCpuTime = -1.0;
+    private static long lastWallClockTime = -1L;
+    private static double smoothedCpuPercent = 0.0D;
+    private static boolean hasSmoothed = false;
+
+    private static String cpuGradient(final double ratio) {
+        if (ratio <= 0.50D) return "<gradient:#55ff55:#00aa00>";
+        if (ratio <= 0.70D) return "<gradient:#ffff55:#ffaa00>";
+        return "<gradient:#ff5555:#aa0000>";
+    }
+    private static BossBar.Color barColorFromCpu(final double ratio) {
+        if (ratio <= 0.50D) return BossBar.Color.GREEN;
+        if (ratio <= 0.70D) return BossBar.Color.YELLOW;
+        return BossBar.Color.RED;
+    }
+
+    private static void remove(final Player player, final BarType type) {
+        final BossBar bar = BARS.get(type).remove(player.getUniqueId());
+        if (bar != null) player.hideBossBar(bar);
+    }
+
+    private static void update(final Player player, final BarType type, final BossBar bar) {
+        final MiniMessage mm = MiniMessage.miniMessage();
+        if (type == BarType.CPU) {
+            final int procs = Runtime.getRuntime().availableProcessors();
+            double raw = 0.0;
+            try {
+                final java.lang.management.OperatingSystemMXBean baseOs = ManagementFactory.getOperatingSystemMXBean();
+                if (baseOs instanceof com.sun.management.OperatingSystemMXBean os) {
+                	final long procCpuTime = os.getProcessCpuTime();
+                	final long now = System.nanoTime();
+                	if (procCpuTime >= 0L) {
+                		if (lastProcCpuTime >= 0.0 && lastWallClockTime >= 0L) {
+                			final long cpuDiff = procCpuTime - (long) lastProcCpuTime;
+                			final long wallDiff = now - lastWallClockTime;
+                			if (wallDiff > 0L && cpuDiff >= 0L) {
+                				raw = ((double) cpuDiff / (double) wallDiff) * 100.0D;
+                			}
+                		}
+                		lastProcCpuTime = procCpuTime;
+                		lastWallClockTime = now;
+                	}
+                }
+            } catch (final Throwable ignored) {}
+            if (!hasSmoothed) {
+                smoothedCpuPercent = raw;
+                hasSmoothed = true;
+            } else {
+                smoothedCpuPercent = (0.3D * raw) + ((1.0D - 0.3D) * smoothedCpuPercent);
+            }
+            final double maxPercent = Math.max(1.0D, procs * 100.0D);
+            final double ratio = Math.min(1.0D, Math.max(0.0D, smoothedCpuPercent / maxPercent));
+            final String grad = cpuGradient(ratio);
+            final Component display = mm.deserialize("<gray>CPU: " + grad + String.format(Locale.ROOT, "%.2f", smoothedCpuPercent) + "</gradient>/" + grad + String.format(Locale.ROOT, "%.2f", maxPercent) + "</gradient> (" + grad + String.format(Locale.ROOT, "%.0f%%", ratio * 100.0D) + "</gradient>)");
+            bar.name(display).progress((float) ratio).color(barColorFromCpu(ratio));
+            return;
+        }
+        if (type == BarType.MEMORY) {
+            final MemoryUsage heap = ManagementFactory.getMemoryMXBean().getHeapMemoryUsage();
+            final long used = heap.getUsed();
+            final long max = heap.getMax();
+            final double percent = Math.clamp((double) used / max, 0.0, 1.0);
+
+            final BossBar.Color barCol = barColorFromMemory(percent);
+            final String usedColor = barCol.name();
+            final Component usedComp = mm.deserialize("<" + usedColor + ">" + String.format("%.2f", used / 1048576.0) + "</" + usedColor + ">");
+            final Component maxComp = mm.deserialize("<GREEN>" + String.format("%.2f", max / 1048576.0) + "</GREEN>");
+
+            final Component msg = mm.deserialize(
+                "<gray>Memory usage <yellow>:</yellow> <used>MB<yellow>/</yellow><available>MB",
+                Placeholder.component("used", usedComp),
+                Placeholder.component("available", maxComp)
+            );
+
+            bar.name(msg).progress((float) percent).color(barCol);
+            return;
+        }
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region = TickRegionScheduler.getCurrentRegion();
+        if (region == null) return;
+        final TickRegions.TickRegionData data = region.getData();
+        final TickData.TickReportData report = data.getRegionSchedulingHandle().getTickReport5s(System.nanoTime());
+        if (report == null) return;
+        final double utilisation = report.utilisation();
+        if (type == BarType.TPS) {
+            final double tps = report.tpsData().segmentAll().average();
+            final double mspt = report.timePerTickData().segmentAll().average() / 1.0E6;
+
+            final BossBar.Color tpsCol = barColorFromTps(tps);
+            final String tpsColorStr = tpsCol.name();
+            final Component tpsComp = mm.deserialize("<" + tpsColorStr + ">" + String.format("%.2f", tps) + "</" + tpsColorStr + ">");
+
+            final BossBar.Color msptCol = barColorFromMspt(mspt);
+            final String msptColorStr = msptCol.name();
+            final Component msptComp = mm.deserialize("<" + msptColorStr + ">" + String.format("%.2f", mspt) + "</" + msptColorStr + ">");
+
+            final net.minecraft.server.level.ServerPlayer handle = ((org.bukkit.craftbukkit.entity.CraftPlayer)player).getHandle();
+            final int ping = handle.connection.latency();
+            final BossBar.Color pingCol = barColorFromPing(ping);
+            final Component pingComp = Component.text(ping, textColor(pingCol));
+
+            final long chunkHot = handle.folia$getNearbyChunkHot();
+            final Component chunkHotComp = Component.text(chunkHot, textColor(barColorFromChunkHot(chunkHot)));
+
+            final Component msg = mm.deserialize(
+                "<gray>TPS<yellow>:</yellow> <tps> MSPT<yellow>:</yellow> <mspt> Ping<yellow>:</yellow> <ping>ms ChunkHot<yellow>:</yellow> <chunkhot>",
+                Placeholder.component("tps", tpsComp),
+                Placeholder.component("mspt", msptComp),
+                Placeholder.component("ping", pingComp),
+                Placeholder.component("chunkhot", chunkHotComp)
+            );
+
+            bar.name(msg).progress((float) Math.clamp(mspt / 50.0, 0.0, 1.0)).color(tpsCol);
+        } else {
+            final TickRegions.RegionStats stats = data.getRegionStats();
+            final double utilisationPercent = utilisation * 100.0;
+            final String formattedUtil = String.format(Locale.ROOT, "%.1f", utilisationPercent);
+
+            final BossBar.Color utilCol = barColorFromUtil(utilisationPercent);
+            final String utilColorStr = utilCol.name();
+            final Component utilComp = mm.deserialize("<" + utilColorStr + ">" + formattedUtil + "%</" + utilColorStr + ">");
+
+            final Component chunksComp = mm.deserialize(String.valueOf(stats.getChunkCount()));
+            final Component playersComp = mm.deserialize(String.valueOf(stats.getPlayerCount()));
+            final Component entitiesComp = mm.deserialize(String.valueOf(stats.getEntityCount()));
+
+            final Component msg = mm.deserialize(
+                "<gray>Util<yellow>:</yellow> <util> Chunks<yellow>:</yellow> <green><chunks></green> Players<yellow>:</yellow> <green><players></green> Entities<yellow>:</yellow> <green><entities></green>",
+                Placeholder.component("util", utilComp),
+                Placeholder.component("chunks", chunksComp),
+                Placeholder.component("players", playersComp),
+                Placeholder.component("entities", entitiesComp)
+            );
+
+            bar.name(msg).progress((float) Math.clamp(utilisation, 0.0, 1.0)).color(utilCol);
+        }
+    }
+
+    private static BossBar.Color barColorFromMemory(double memPercent) {
+        if (memPercent <= 0.50) return BossBar.Color.GREEN;
+        if (memPercent <= 0.70) return BossBar.Color.YELLOW;
+        return BossBar.Color.RED;
+    }
+
+    private static BossBar.Color barColorFromTps(double tps) {
+        if (tps >= 18) return BossBar.Color.GREEN;
+        if (tps >= 15) return BossBar.Color.YELLOW;
+        return BossBar.Color.RED;
+    }
+
+    private static BossBar.Color barColorFromMspt(double mspt) {
+        if (mspt <= 25) return BossBar.Color.GREEN;
+        if (mspt <= 50) return BossBar.Color.YELLOW;
+        return BossBar.Color.RED;
+    }
+
+    private static BossBar.Color barColorFromPing(int ping) {
+        if (ping < 0) return BossBar.Color.PURPLE;
+        if (ping <= 80) return BossBar.Color.GREEN;
+        if (ping <= 160) return BossBar.Color.YELLOW;
+        return BossBar.Color.RED;
+    }
+
+    private static BossBar.Color barColorFromChunkHot(long chunkHot) {
+        if (chunkHot < 0) return BossBar.Color.PURPLE;
+        if (chunkHot <= 300_000L) return BossBar.Color.GREEN;
+        if (chunkHot <= 500_000L) return BossBar.Color.YELLOW;
+        return BossBar.Color.RED;
+    }
+
+    private static NamedTextColor textColor(final BossBar.Color color) {
+        return switch (color) {
+            case PINK, PURPLE -> NamedTextColor.LIGHT_PURPLE;
+            case BLUE -> NamedTextColor.BLUE;
+            case RED -> NamedTextColor.RED;
+            case YELLOW -> NamedTextColor.YELLOW;
+            case WHITE -> NamedTextColor.WHITE;
+            case GREEN -> NamedTextColor.GREEN;
+        };
+    }
+
+    private static BossBar.Color barColorFromUtil(double util) {
+        if (util > 100) return BossBar.Color.PURPLE;
+        if (util >= 70) return BossBar.Color.RED;
+        if (util >= 50) return BossBar.Color.YELLOW;
+        return BossBar.Color.GREEN;
+    }
+
+    private enum BarType {
+        TPS("tpsbar"), MEMORY("membar"), REGION("regionbar"), CPU("cpubar");
+        private final NamespacedKey key;
+        BarType(final String key) { this.key = new NamespacedKey("folia", key); }
+    }
+}
