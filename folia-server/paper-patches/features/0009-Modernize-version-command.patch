+    private static Component hardwareInfo() {
+        final TextComponent.Builder info = Component.text().color(MUTED);
+        try {
+            final oshi.hardware.HardwareAbstractionLayer hardware = new oshi.SystemInfo().getHardware();
+            try {
+                final oshi.hardware.CentralProcessor cpu = hardware.getProcessor();
+                info.append(Component.text("CPU      "))
+                    .append(Component.text(cpu.getProcessorIdentifier().getName().trim(), TEXT))
+                    .appendNewline()
+                    .append(Component.text("Cores    "))
+                    .append(Component.text(cpu.getPhysicalProcessorCount() + " cores / " + cpu.getLogicalProcessorCount() + " threads", TEXT));
+            } catch (RuntimeException | LinkageError unavailable) {
+                info.append(Component.text("CPU      N/A"));
+            }
+            info.appendNewline().append(Component.text("RAM      "));
+            try {
+                final oshi.hardware.GlobalMemory memory = hardware.getMemory();
+                info.append(Component.text(String.format(Locale.ROOT, "%.2f GB", memory.getTotal() / 1073741824.0D), TEXT));
+                String type = "N/A";
+                try {
+                    // ponytail: use OS-reported DIMM types; no privileged probing when unavailable.
+                    type = memory.getPhysicalMemory().stream()
+                        .map(oshi.hardware.PhysicalMemory::getMemoryType)
+                        .filter(value -> value != null && !value.isBlank() && !value.equalsIgnoreCase("unknown"))
+                        .distinct().sorted().collect(java.util.stream.Collectors.joining(" / "));
+                } catch (RuntimeException | LinkageError unavailable) {
+                    // DIMM information is often hidden in containers or without firmware access.
+                }
+                info.append(Component.text(" / " + (type.isBlank() ? "N/A" : type), TEXT));
+            } catch (RuntimeException | LinkageError unavailable) {
+                info.append(Component.text("N/A"));
+            }
+        } catch (RuntimeException | LinkageError unavailable) {
+            info.append(Component.text("Hardware N/A"));
+        }
+        return info.build();
+    }
+
+    private static Component serverInfo(final Component status, final Component hardware) {
+        final ServerBuildInfo build = ServerBuildInfo.buildInfo();
+        final Component message = Component.text()
+            .color(MUTED)
+            .append(HEADER)
+            .append(Component.text("SERVER INFO", TEXT))
+            .appendNewline()
+            .append(Component.text("Version  "))
+            .append(Component.text(build.asString(ServerBuildInfo.StringRepresentation.VERSION_SIMPLE), TEXT))
+            .appendNewline()
+            .append(Component.text("Branch   "))
+            .append(Component.text(build.gitBranch().orElse("unknown"), TEXT))
+            .appendNewline()
+            .append(Component.text("API      "))
+            .append(Component.text(Bukkit.getBukkitVersion(), TEXT))
+            .appendNewline()
+            .append(Component.text("Status   "))
+            .append(status)
+            .appendNewline()
+            .appendNewline()
+            .append(hardware)
+            .appendNewline()
+            .append(io.papermc.paper.threadedregions.FoliaStatusBarCommand.systemUsage())
+            .build();
 
+        return message.appendNewline()
+            .append(Component.text("[Copy info]", ACCENT)
+                .hoverEvent(Component.translatable("chat.copy.click", TEXT))
+                .clickEvent(ClickEvent.copyToClipboard(Bukkit.getVersionMessage() + "\n" + PlainTextComponentSerializer.plainText().serialize(message))))
+            .append(Component.text("  "))
+            .append(Component.text("[Source]", ACCENT)
+                .hoverEvent(Component.text("Open the Folia source repository", TEXT))
+                .clickEvent(ClickEvent.openUrl("https://github.com/LisoSMP-de/Folia")));
+    }
+
     record ComputedVersion(Component message, long computedTime) {
 
