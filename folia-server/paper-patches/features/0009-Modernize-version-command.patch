Subject: [PATCH] Modernize version command

diff --git a/src/main/java/io/papermc/paper/command/PaperVersionCommand.java b/src/main/java/io/papermc/paper/command/PaperVersionCommand.java
--- a/src/main/java/io/papermc/paper/command/PaperVersionCommand.java
+++ b/src/main/java/io/papermc/paper/command/PaperVersionCommand.java
@@ -10,6 +10,7 @@
 import io.papermc.paper.InternalAPIBridge;
+import io.papermc.paper.ServerBuildInfo;
 import io.papermc.paper.command.brigadier.CommandSourceStack;
 import io.papermc.paper.command.brigadier.Commands;
 import io.papermc.paper.plugin.configuration.PluginMeta;
 import java.util.Arrays;
 import java.util.List;
@@ -20,8 +21,8 @@
 import net.kyori.adventure.text.TextComponent;
 import net.kyori.adventure.text.event.ClickEvent;
-import net.kyori.adventure.text.format.NamedTextColor;
-import net.kyori.adventure.text.format.TextDecoration;
+import net.kyori.adventure.text.format.TextColor;
+import net.kyori.adventure.text.minimessage.MiniMessage;
 import net.kyori.adventure.text.serializer.plain.PlainTextComponentSerializer;
 import net.minecraft.server.MinecraftServer;
 import org.bukkit.Bukkit;
 import org.bukkit.command.CommandSender;
@@ -36,12 +37,16 @@
+    private static final TextColor ACCENT = TextColor.color(0x38BDF8);
+    private static final TextColor MUTED = TextColor.color(0x94A3B8);
+    private static final TextColor TEXT = TextColor.color(0xF8FAFC);
+    private static final Component HEADER = MiniMessage.miniMessage().deserialize("<#334155><strikethrough>--------------------------------</strikethrough></#334155><newline><bold><gradient:#38BDF8:#1D2FC2>FOLIA</gradient></bold> <#64748B>/</#64748B> ");
     private static final Component NOT_RUNNING = Component.text()
-        .append(Component.text("This server is not running any plugin by that name."))
+        .append(Component.text("Folia / No matching plugin found.", TextColor.color(0xFBBF24)))
         .appendNewline()
-        .append(Component.text("Use /plugins to get a list of plugins.").clickEvent(ClickEvent.suggestCommand("/plugins")))
+        .append(Component.text("[Browse plugins]", ACCENT).clickEvent(ClickEvent.suggestCommand("/plugins")))
         .build();
     private static final JoinConfiguration PLAYER_JOIN_CONFIGURATION = JoinConfiguration.separators(
-        Component.text(", ", NamedTextColor.WHITE),
-        Component.text(", and ", NamedTextColor.WHITE)
+        Component.text(", ", MUTED),
+        Component.text(", and ", MUTED)
     );
-    private static final Component FAILED_TO_FETCH = Component.text("Could not fetch version information!", NamedTextColor.RED);
-    private static final Component FETCHING = Component.text("Checking version, please wait...", NamedTextColor.WHITE, TextDecoration.ITALIC);
+    private static final Component FAILED_TO_FETCH = Component.text("Folia / Version check unavailable. Try /version again.", TextColor.color(0xFB7185));
+    private static final Component FETCHING = Component.text("Folia / Checking for updates...", ACCENT);
 
@@ -96,9 +101,15 @@
         final PluginMeta meta = plugin.getPluginMeta();
 
         final TextComponent.Builder builder = Component.text()
-            .append(Component.text(meta.getName()))
-            .append(Component.text(" version "))
-            .append(Component.text(meta.getVersion(), NamedTextColor.GREEN)
+            .color(MUTED)
+            .append(HEADER)
+            .append(Component.text("PLUGIN INFO", TEXT))
+            .appendNewline()
+            .append(Component.text("Name     "))
+            .append(Component.text(meta.getName(), TEXT))
+            .appendNewline()
+            .append(Component.text("Version  "))
+            .append(Component.text(meta.getVersion(), ACCENT)
                 .hoverEvent(Component.translatable("chat.copy.click"))
                 .clickEvent(ClickEvent.copyToClipboard(meta.getVersion()))
             );
@@ -107,10 +118,10 @@
             builder
                 .appendNewline()
-                .append(Component.text(meta.getDescription()));
+                .append(Component.text(meta.getDescription(), TEXT));
         }
 
         if (meta.getWebsite() != null) {
-            Component websiteComponent = Component.text(meta.getWebsite(), NamedTextColor.GREEN).clickEvent(ClickEvent.openUrl(meta.getWebsite()));
+            Component websiteComponent = Component.text(meta.getWebsite(), ACCENT).clickEvent(ClickEvent.openUrl(meta.getWebsite()));
             builder.appendNewline().append(Component.text("Website: ").append(websiteComponent));
         }
 
@@ -126,7 +137,7 @@
     }
 
     private static Component formatNameList(final List<String> names) {
-        return Component.join(PLAYER_JOIN_CONFIGURATION, names.stream().map(Component::text).toList()).color(NamedTextColor.GREEN);
+        return Component.join(PLAYER_JOIN_CONFIGURATION, names.stream().map(Component::text).toList()).color(ACCENT);
     }
 
     private int serverVersion(CommandContext<CommandSourceStack> context) {
@@ -165,15 +176,34 @@
     private CompletableFuture<ComputedVersion> fetchVersionMessage() {
        return CompletableFuture.supplyAsync(() -> {
-           final Component message = Component.textOfChildren(
-               Component.text(Bukkit.getVersionMessage(), NamedTextColor.WHITE),
-               Component.newline(),
-               this.versionFetcher.getVersionMessage()
-           );
+           final ServerBuildInfo build = ServerBuildInfo.buildInfo();
+           final Component message = Component.text()
+               .color(MUTED)
+               .append(HEADER)
+               .append(Component.text("SERVER INFO", TEXT))
+               .appendNewline()
+               .append(Component.text("Version  "))
+               .append(Component.text(build.asString(ServerBuildInfo.StringRepresentation.VERSION_SIMPLE), TEXT))
+               .appendNewline()
+               .append(Component.text("Branch   "))
+               .append(Component.text(build.gitBranch().orElse("unknown"), TEXT))
+               .appendNewline()
+               .append(Component.text("API      "))
+               .append(Component.text(Bukkit.getBukkitVersion(), TEXT))
+               .appendNewline()
+               .append(Component.text("Status   "))
+               .append(this.versionFetcher.getVersionMessage())
+               .build();
 
            return new ComputedVersion(
-               message.hoverEvent(Component.translatable("chat.copy.click", NamedTextColor.WHITE))
-                   .clickEvent(ClickEvent.copyToClipboard(PlainTextComponentSerializer.plainText().serialize(message))),
+               message.appendNewline()
+                   .append(Component.text("[Copy info]", ACCENT)
+                       .hoverEvent(Component.translatable("chat.copy.click", TEXT))
+                       .clickEvent(ClickEvent.copyToClipboard(Bukkit.getVersionMessage() + "\n" + PlainTextComponentSerializer.plainText().serialize(message))))
+                   .append(Component.text("  "))
+                   .append(Component.text("[Source]", ACCENT)
+                       .hoverEvent(Component.text("Open the Folia source repository", TEXT))
+                       .clickEvent(ClickEvent.openUrl("https://github.com/LisoSMP-de/Folia"))),
                System.currentTimeMillis()
            );
        });
     }
