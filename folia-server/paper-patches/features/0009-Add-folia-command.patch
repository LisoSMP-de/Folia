+
+    private static void saveBukkitConfig(final CraftServer craftServer) {
+        try {
+            final File configFile = (File) craftServer.getServer().options.valueOf("bukkit-settings");
+            craftServer.spigot().getBukkitConfig().save(configFile);
+        } catch (final IOException e) {
+            Bukkit.getLogger().log(Level.SEVERE, "[Folia] Konnte bukkit.yml nicht speichern", e);
+        }
+    }
+
+    private static void saveSpigotConfig() {
+        try {
+            final Field configFileField = SpigotConfig.class.getDeclaredField("CONFIG_FILE");
+            configFileField.setAccessible(true);
+            final File configFile = (File) configFileField.get(null);
+            if (configFile != null) {
+                SpigotConfig.config.save(configFile);
+            }
+        } catch (final Exception e) {
+            Bukkit.getLogger().log(Level.SEVERE, "[Folia] Konnte spigot.yml nicht speichern", e);
+        }
+    }
+
+    private void handleGet(final CommandSender sender, final DedicatedServer server) {
+        final CraftServer craftServer = (CraftServer) Bukkit.getServer();
+        final int hopperTransfer = SpigotConfig.config.getInt("world-settings.default.ticks-per.hopper-transfer", 8);
+        final int hopperAmount = SpigotConfig.config.getInt("world-settings.default.hopper-amount", 1);
+        final int hopperCheck = SpigotConfig.config.getInt("world-settings.default.ticks-per.hopper-check", 1);
+
+        sender.sendMessage(MM.deserialize(PREFIX + "<gradient:#38BDF8:#1D2FC2><b>Aktuelle Server Konfigurationen:</b></gradient>"));
+        sender.sendMessage(MM.deserialize("  <gray>View Distance (server.properties):</gray> <yellow>" + server.viewDistance() + "</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>Simulation Distance (server.properties):</gray> <yellow>" + server.simulationDistance() + "</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>Max Slots (server.properties):</gray> <yellow>" + server.getMaxPlayers() + "</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>MOTD (server.properties):</gray> <yellow>" + server.getMotd() + "</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>Allow Flight (server.properties):</gray> <yellow>" + server.allowFlight() + "</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>Whitelist (server.properties):</gray> <yellow>" + server.isUsingWhitelist() + "</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>Spawn Protection (server.properties):</gray> <yellow>" + server.spawnProtectionRadius() + "</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>Player Idle Timeout (server.properties):</gray> <yellow>" + server.playerIdleTimeout() + " min</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>Entity Tracking Range (server.properties):</gray> <yellow>" + server.entityBroadcastRangePercentage() + "%</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>Pause When Empty (server.properties):</gray> <yellow>" + server.pauseWhenEmptySeconds() + "s</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>Allow End (bukkit.yml):</gray> <yellow>" + craftServer.getAllowEnd() + "</yellow> <red>(Neustart erforderlich)</red>"));
+        sender.sendMessage(MM.deserialize("  <gray>Hopper Transfer (spigot.yml):</gray> <yellow>" + hopperTransfer + " ticks</yellow>"));
+        sender.sendMessage(MM.deserialize("  <gray>Hopper Amount (spigot.yml):</gray> <yellow>" + hopperAmount + "</yellow>"));
