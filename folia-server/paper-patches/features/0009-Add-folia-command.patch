+        @Override
+    public @NotNull List<String> tabComplete(@NotNull CommandSender sender, @NotNull String alias, @NotNull String[] args) {
+        if (!sender.hasPermission(PERMISSION)) {
+            return Collections.emptyList();
+        }
+
+        final String last = args[args.length - 1].toLowerCase(Locale.ROOT);
+
+        if (args.length == 1) {
+            final List<String> subs = List.of(
+                "get", "hopper", "viewdistance", "simulationdistance", "maxslots", "allowend",
+                "motd", "allowflight", "whitelist", "spawnprotection",
+                "idletimeout", "entitytracking", "pausewhenempty", "reload"
+            );
+            return filterStartsWith(subs, last);
+        }
+
+        if (args.length == 2) {
+            final String sub = args[0].toLowerCase(Locale.ROOT);
+            if (sub.equals("hopper")) {
+                return filterStartsWith(List.of("speed", "amount", "check"), last);
+            }
+            if (sub.equals("viewdistance") || sub.equals("view-distance") || sub.equals("vd")) {
+                return filterStartsWith(List.of("2", "4", "6", "8", "10", "12", "16", "32"), last);
+            }
+            if (sub.equals("simulationdistance") || sub.equals("simulation-distance") || sub.equals("simdistance") || sub.equals("sd")) {
+                return filterStartsWith(List.of("2", "4", "6", "8", "10", "12"), last);
+            }
+            if (sub.equals("maxslots") || sub.equals("maxplayers") || sub.equals("slots")) {
+                return filterStartsWith(List.of("20", "50", "100", "200"), last);
+            }
+            if (sub.equals("allowend") || sub.equals("allow-end") || sub.equals("end") || sub.equals("allowflight") || sub.equals("flight") || sub.equals("fly") || sub.equals("whitelist") || sub.equals("wl")) {
+                return filterStartsWith(List.of("true", "false"), last);
+            }
+            if (sub.equals("spawnprotection") || sub.equals("spawn-protection")) {
+                return filterStartsWith(List.of("0", "16", "32"), last);
+            }
+            if (sub.equals("idletimeout") || sub.equals("idle-timeout") || sub.equals("afktimeout")) {
+                return filterStartsWith(List.of("0", "5", "10", "15", "30"), last);
+            }
+            if (sub.equals("entitytracking") || sub.equals("entity-broadcast-range") || sub.equals("trackingrange")) {
+                return filterStartsWith(List.of("50", "100", "150", "200"), last);
+            }
+            if (sub.equals("pausewhenempty") || sub.equals("pause-when-empty") || sub.equals("pause")) {
+                return filterStartsWith(List.of("-1", "60", "300"), last);
+            }
+            if (sub.equals("hopperspeed") || sub.equals("hopper-transfer") || sub.equals("hoppertransfer") || sub.equals("hopperdelay")) {
+                return filterStartsWith(List.of("1", "2", "4", "8"), last);
+            }
+            if (sub.equals("hopperamount") || sub.equals("hopper-amount")) {
+                return filterStartsWith(List.of("1", "2", "4", "8", "16", "64"), last);
+            }
+            if (sub.equals("hoppercheck") || sub.equals("hopper-check")) {
+                return filterStartsWith(List.of("1", "2", "4", "8"), last);
+            }
+        }
+
+        if (args.length == 3) {
+            final String sub = args[0].toLowerCase(Locale.ROOT);
+            if (sub.equals("hopper")) {
+                final String hopperSub = args[1].toLowerCase(Locale.ROOT);
+                if (hopperSub.equals("speed") || hopperSub.equals("transfer") || hopperSub.equals("transfer-delay") || hopperSub.equals("delay")) {
+                    return filterStartsWith(List.of("1", "2", "4", "8"), last);
+                }
+                if (hopperSub.equals("amount") || hopperSub.equals("item-amount") || hopperSub.equals("items")) {
+                    return filterStartsWith(List.of("1", "2", "4", "8", "16", "64"), last);
+                }
+                if (hopperSub.equals("check") || hopperSub.equals("check-delay")) {
+                    return filterStartsWith(List.of("1", "2", "4", "8"), last);
+                }
+            }
+        }
+
+        return Collections.emptyList();
+    }
+
+    private static List<String> filterStartsWith(final List<String> list, final String prefix) {
+        final List<String> result = new ArrayList<>();
+        for (final String s : list) {
+            if (s.toLowerCase(Locale.ROOT).startsWith(prefix)) {
+                result.add(s);
+            }
+        }
+        return result;
+    }
