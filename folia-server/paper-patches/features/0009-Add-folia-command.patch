+public final class FoliaCommand extends Command {
+    private static final String PERMISSION = "folia.command.folia";
+    private static final MiniMessage MM = MiniMessage.miniMessage();
+
+    private static final String PREFIX = "<bold><gradient:#38BDF8:#1D2FC2>FOLIA</gradient></bold> <gray>»</gray> ";
+
+    public FoliaCommand() {
+        super("folia");
+        this.description = "Configure Folia server settings";
+        this.usageMessage = "/folia <viewdistance|simulationdistance|maxslots|motd|allowflight|whitelist|spawnprotection|idletimeout|entitytracking|pausewhenempty|allowend|allow-end|hopperspeed|hopperamount|hoppercheck|get|reload> [value]";
+        this.setPermission(PERMISSION);
+        final PluginManager pm = Bukkit.getServer().getPluginManager();
+        if (pm.getPermission(PERMISSION) == null) {
+            pm.addPermission(new Permission(PERMISSION, "Allows using the /folia command", PermissionDefault.OP));
+        }
+    }
+
+    @Override
+    public boolean execute(@NotNull CommandSender sender, @NotNull String commandLabel, @NotNull String[] args) {
+        if (!this.testPermission(sender)) {
+            return true;
+        }
+
+        if (args.length == 0) {
+            this.sendHelp(sender);
+            return true;
+        }
+
+        final DedicatedServer dedicatedServer = ((CraftServer) Bukkit.getServer()).getServer();
+        final String sub = args[0].toLowerCase(Locale.ROOT);
+
+        switch (sub) {
+            case "viewdistance", "view-distance", "vd" -> this.handleViewDistance(sender, dedicatedServer, args);
+            case "simulationdistance", "simulation-distance", "simdistance", "sd" -> this.handleSimulationDistance(sender, dedicatedServer, args);
+            case "maxslots", "maxplayers", "max-slots", "max-players", "slots" -> this.handleMaxSlots(sender, dedicatedServer, args);
+            case "motd" -> this.handleMotd(sender, dedicatedServer, args);
+            case "allowflight", "flight", "fly" -> this.handleAllowFlight(sender, dedicatedServer, args);
+            case "whitelist", "wl" -> this.handleWhitelist(sender, dedicatedServer, args);
+            case "spawnprotection", "spawn-protection" -> this.handleSpawnProtection(sender, dedicatedServer, args);
+            case "idletimeout", "idle-timeout", "afktimeout" -> this.handleIdleTimeout(sender, dedicatedServer, args);
+            case "entitytracking", "entity-broadcast-range", "trackingrange" -> this.handleEntityTracking(sender, dedicatedServer, args);
+            case "pausewhenempty", "pause-when-empty", "pause" -> this.handlePauseWhenEmpty(sender, dedicatedServer, args);
+            case "allowend", "allow-end", "end" -> this.handleAllowEnd(sender, args);
+            case "hopper" -> this.handleHopper(sender, args);
+            case "hopperspeed", "hopper-transfer", "hoppertransfer", "hopperdelay" -> this.handleHopperSpeed(sender, args.length >= 2 ? args[1] : null);
+            case "hopperamount", "hopper-amount" -> this.handleHopperAmount(sender, args.length >= 2 ? args[1] : null);
+            case "hoppercheck", "hopper-check" -> this.handleHopperCheck(sender, args.length >= 2 ? args[1] : null);
+            case "get", "info", "status" -> this.handleGet(sender, dedicatedServer);
+            case "reload" -> this.handleReload(sender, dedicatedServer);
+            default -> {
+                sender.sendMessage(MM.deserialize(PREFIX + "<red>Unbekannter Unterbefehl: <yellow>" + args[0] + "</yellow></red>"));
+                this.sendHelp(sender);
+            }
+        }
+        return true;
+    }
+
+    private void handleViewDistance(final CommandSender sender, final DedicatedServer server, final String[] args) {
+        if (args.length < 2) {
+            final int current = server.viewDistance();
+            sender.sendMessage(MM.deserialize(PREFIX + "<gray>Aktuelle View Distance: <yellow>" + current + "</yellow></gray>"));
+            return;
+        }
+
+        final int val;
+        try {
+            val = Integer.parseInt(args[1]);
+        } catch (final NumberFormatException e) {
+            sender.sendMessage(MM.deserialize(PREFIX + "<red>Ungültige Zahl: <yellow>" + args[1] + "</yellow></red>"));
+            return;
+        }
+
+        if (val < 2 || val > 32) {
+            sender.sendMessage(MM.deserialize(PREFIX + "<red>View Distance muss zwischen <yellow>2</yellow> und <yellow>32</yellow> liegen.</red>"));
+            return;
+        }
+
+        final int oldVal = server.viewDistance();
+        server.setViewDistance(val);
+        for (final World world : Bukkit.getWorlds()) {
+            world.setViewDistance(val);
+        }
+
+        broadcastChange(sender, "View Distance", String.valueOf(oldVal), String.valueOf(val), false);
+    }
+
