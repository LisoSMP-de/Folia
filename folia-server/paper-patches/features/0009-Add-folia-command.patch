+    }
+
+        private void handleHopper(final CommandSender sender, final String[] args) {
+        if (args.length < 2) {
+            sender.sendMessage(MM.deserialize(PREFIX + "<gradient:#38BDF8:#1D2FC2><b>Hopper Einstellungen:</b></gradient>"));
+            sender.sendMessage(MM.deserialize("  <aqua>/folia hopper speed &lt;ticks&gt;</aqua> <dark_gray>-</dark_gray> <gray>Transfer-Delay in Ticks (Standard: 8)</gray>"));
+            sender.sendMessage(MM.deserialize("  <aqua>/folia hopper amount &lt;1-64&gt;</aqua> <dark_gray>-</dark_gray> <gray>Items pro Transfer (Standard: 1)</gray>"));
+            sender.sendMessage(MM.deserialize("  <aqua>/folia hopper check &lt;ticks&gt;</aqua> <dark_gray>-</dark_gray> <gray>Check-Delay in Ticks (Standard: 1)</gray>"));
+            return;
+        }
+
+        final String sub = args[1].toLowerCase(Locale.ROOT);
+        final String valArg = args.length >= 3 ? args[2] : null;
+
+        switch (sub) {
+            case "speed", "transfer", "transfer-delay", "delay" -> this.handleHopperSpeed(sender, valArg);
+            case "amount", "item-amount", "items" -> this.handleHopperAmount(sender, valArg);
+            case "check", "check-delay" -> this.handleHopperCheck(sender, valArg);
+            default -> sender.sendMessage(MM.deserialize(PREFIX + "<red>Unbekannte Hopper-Einstellung: <yellow>" + args[1] + "</yellow>. Nutze: <yellow>speed, amount, check</yellow></red>"));
+        }
+    }
+
+    private void handleHopperSpeed(final CommandSender sender, final String valArg) {
+        if (valArg == null) {
+            final int current = SpigotConfig.config.getInt("world-settings.default.ticks-per.hopper-transfer", 8);
+            sender.sendMessage(MM.deserialize(PREFIX + "<gray>Aktueller Hopper Transfer Delay (spigot.yml): <yellow>" + current + " ticks</yellow></gray>"));
+            return;
+        }
+
+        final int val;
+        try {
+            val = Integer.parseInt(valArg);
+        } catch (final NumberFormatException e) {
+            sender.sendMessage(MM.deserialize(PREFIX + "<red>Ungültige Zahl: <yellow>" + valArg + "</yellow></red>"));
+            return;
+        }
+
+        if (val < 1) {
+            sender.sendMessage(MM.deserialize(PREFIX + "<red>Hopper Transfer muss >= 1 Tick sein.</red>"));
+            return;
+        }
+
+        final int oldVal = SpigotConfig.config.getInt("world-settings.default.ticks-per.hopper-transfer", 8);
+        SpigotConfig.config.set("world-settings.default.ticks-per.hopper-transfer", val);
+
+        for (final World world : Bukkit.getWorlds()) {
+            final ServerLevel nms = ((CraftWorld) world).getHandle();
+            nms.spigotConfig.hopperTransfer = val;
+            SpigotConfig.config.set("world-settings." + world.getName() + ".ticks-per.hopper-transfer", val);
+        }
+        saveSpigotConfig();
+
+        broadcastChange(sender, "Hopper Transfer Speed (spigot.yml)", oldVal + " ticks", val + " ticks", false);
+    }
+
