+import org.jetbrains.annotations.NotNull;
+
+/** Folia-native TPS, memory, and region status bars, ported from Luminol's bar patch. */
+public final class FoliaStatusBarCommand extends BukkitCommand {
+    private static final Logger LOGGER = Bukkit.getLogger();
+    private static final Plugin INTERNAL_PLUGIN = new FoliaStatusBarPlugin();
+    private static final Map<BarType, Map<UUID, BossBar>> BARS = new ConcurrentHashMap<>();
+    private static ScheduledTask scannerTask;
+    private final BarType fixedType;
+
+    public FoliaStatusBarCommand() {
+        super("bar", "Toggle Folia status bars", "/bar <tps|memory|region|cpu> [player]", List.of("statusbar"));
+        this.setPermission("folia.command.bar");
+        this.fixedType = null;
+        for (final BarType type : BarType.values()) {
+            BARS.put(type, new ConcurrentHashMap<>());
+        }
+    }
+
+    private FoliaStatusBarCommand(final String name, final BarType type) {
+        super(name, "Toggle the Folia " + name, "/" + name + " [player]", List.of());
+        this.setPermission("folia.command." + name);
+        this.fixedType = type;
+    }
+
+    public static FoliaStatusBarCommand tpsBarCommand() {
+        return new FoliaStatusBarCommand("tpsbar", BarType.TPS);
+    }
+
+    public static FoliaStatusBarCommand ramBarCommand() {
+        return new FoliaStatusBarCommand("rambar", BarType.MEMORY);
+    }
+
+    public static FoliaStatusBarCommand regionBarCommand() {
+        return new FoliaStatusBarCommand("regionbar", BarType.REGION);
+    }
+
+    public static FoliaStatusBarCommand cpuBarCommand() {
+        return new FoliaStatusBarCommand("cpubar", BarType.CPU);
+    }
+
+    public static synchronized void start() {
+        if (scannerTask != null && !scannerTask.isCancelled()) return;
+        scannerTask = Bukkit.getGlobalRegionScheduler().runAtFixedRate(INTERNAL_PLUGIN, task -> {
+            for (final Player player : Bukkit.getOnlinePlayers()) {
+                for (final BarType type : BarType.values()) {
+                    if (enabled(player, type) && !BARS.get(type).containsKey(player.getUniqueId())) {
+                        schedule(player, type);
+                    }
+                }
+            }
+        }, 1L, 20L);
+        tryRegisterPlaceholderExpansion();
+        Bukkit.getPluginManager().registerEvents(new org.bukkit.event.Listener() {
+            @org.bukkit.event.EventHandler
+            public void onPluginEnable(final org.bukkit.event.server.PluginEnableEvent event) {
+                if ("PlaceholderAPI".equalsIgnoreCase(event.getPlugin().getName())) {
+                    tryRegisterPlaceholderExpansion();
+                }
+            }
+        }, INTERNAL_PLUGIN);
+    }
+
+    private static boolean papiRegistered = false;
+    private static void tryRegisterPlaceholderExpansion() {
+        if (papiRegistered) return;
+        if (Bukkit.getPluginManager().isPluginEnabled("PlaceholderAPI")) {
+            PapiHook.register();
+            papiRegistered = true;
+        }
+    }
+
+    public static synchronized void stop() {
+        if (scannerTask != null) scannerTask.cancel();
+        scannerTask = null;
+        for (final Map<UUID, BossBar> bars : BARS.values()) bars.clear();
+    }
+
+    @Override
+    public boolean execute(@NotNull CommandSender sender, @NotNull String label, @NotNull String[] args) {
+        if (!this.testPermission(sender)) return true;
+        final BarType type;
+        final int targetIndex;
+        if (this.fixedType != null) {
+            type = this.fixedType;
+            targetIndex = 0;
+        } else {
+            if (args.length == 0) {
+                sender.sendMessage(Component.text(this.getUsage(), NamedTextColor.RED));
+                return true;
+            }
+            final String typeName = args[0].toLowerCase(Locale.ROOT);
+            if ("ram".equals(typeName) || "memory".equals(typeName)) {
+                type = BarType.MEMORY;
+            } else {
+                try {
+                    type = BarType.valueOf(typeName.toUpperCase(Locale.ROOT));
+                } catch (final IllegalArgumentException ignored) {
+                    sender.sendMessage(Component.text("Unknown bar. Use tps, memory, region, or cpu.", NamedTextColor.RED));
+                    return true;
+                }
+            }
+            targetIndex = 1;
+        }
+        final Player target;
+        if (args.length > targetIndex) {
+            target = Bukkit.getPlayer(args[targetIndex]);
+            if (target == null) {
+                sender.sendMessage(Component.text("Player not found: " + args[targetIndex], NamedTextColor.RED));
+                return true;
+            }
+        } else {
+            if (!(sender instanceof Player playerSender)) {
+                sender.sendMessage(Component.text("Please specify a target player.", NamedTextColor.RED));
+                return true;
+            }
+            target = playerSender;
+        }
+        final boolean current = enabled(target, type);
+        final boolean value = !current;
+        final net.minecraft.server.level.ServerPlayer handle = ((org.bukkit.craftbukkit.entity.CraftPlayer) target).getHandle();
+        switch (type) {
+            case TPS -> handle.tpsBarEnabled = value;
+            case MEMORY -> handle.memBarEnabled = value;
+            case REGION -> handle.regionBarEnabled = value;
+            case CPU -> handle.cpuBarEnabled = value;
+        }
+        if (value) {
+            schedule(target, type);
+        } else {
+            remove(target, type);
+        }
+        Command.broadcastCommandMessage(sender, Component.text((value ? "Enabled " : "Disabled ") + type.name().toLowerCase(Locale.ROOT) + " bar for " + target.getName() + "."));
+        return true;
+    }
+
+    @Override
+    public @NotNull List<String> tabComplete(@NotNull CommandSender sender, @NotNull String alias, @NotNull String[] args) {
+        final List<String> result = new ArrayList<>();
+        if (this.fixedType == null) {
+            if (args.length == 1) {
+                for (final BarType type : BarType.values()) result.add(type.name().toLowerCase(Locale.ROOT));
+            } else if (args.length == 2) {
+                for (final Player player : Bukkit.getOnlinePlayers()) result.add(player.getName());
+            }
+        } else {
+            if (args.length == 1) {
+                for (final Player player : Bukkit.getOnlinePlayers()) result.add(player.getName());
+            }
+        }
+        final String last = args[args.length - 1].toLowerCase(Locale.ROOT);
+        result.removeIf(value -> !value.toLowerCase(Locale.ROOT).startsWith(last));
+        return result;
+    }
+
+    private static boolean enabled(final Player player, final BarType type) {
+        final net.minecraft.server.level.ServerPlayer handle = ((org.bukkit.craftbukkit.entity.CraftPlayer) player).getHandle();
+        return switch (type) {
+            case TPS -> handle.tpsBarEnabled;
+            case MEMORY -> handle.memBarEnabled;
+            case REGION -> handle.regionBarEnabled;
+            case CPU -> handle.cpuBarEnabled;
+        };
+    }
+
+    private static void schedule(final Player player, final BarType type) {
+        final UUID uuid = player.getUniqueId();
+        final BossBar bar = BossBar.bossBar(Component.empty(), 0.0F, BossBar.Color.GREEN, BossBar.Overlay.NOTCHED_20);
+        if (BARS.get(type).putIfAbsent(uuid, bar) != null) return;
+        player.showBossBar(bar);
+        player.getScheduler().runAtFixedRate(INTERNAL_PLUGIN, task -> {
+            if (!player.isOnline() || !enabled(player, type)) {
+                task.cancel();
+                remove(player, type);
+                return;
+            }
+            update(player, type, bar);
+        }, () -> BARS.get(type).remove(uuid), 1L, 20L);
+    }
+
+    private static double lastProcCpuTime = -1.0;
+    private static long lastWallClockTime = -1L;
+    private static double smoothedCpuPercent = 0.0D;
+    private static boolean hasSmoothed = false;
+
+    // --- shared gradient constants ---
+    private static final String GRAD_GREEN  = "<gradient:#55ff55:#00aa00>";
+    private static final String GRAD_YELLOW = "<gradient:#ffff55:#ffaa00>";
+    private static final String GRAD_RED    = "<gradient:#ff5555:#aa0000>";
+    private static final String GRAD_PURPLE = "<gradient:#ff55ff:#aa00aa>";
+    private static final String GRAD_END    = "</gradient>";
+
+    private static String cpuGradient(final double ratio) {
+        if (ratio <= 0.50D) return GRAD_GREEN;
+        if (ratio <= 0.70D) return GRAD_YELLOW;
+        return GRAD_RED;
+    }
+    private static String memGradient(final double ratio) {
+        if (ratio <= 0.50D) return GRAD_GREEN;
+        if (ratio <= 0.70D) return GRAD_YELLOW;
+        return GRAD_RED;
+    }
+    private static String tpsGradient(final double tps) {
+        if (tps >= 18) return GRAD_GREEN;
+        if (tps >= 15) return GRAD_YELLOW;
+        return GRAD_RED;
+    }
+    private static String msptGradient(final double mspt) {
+        if (mspt <= 25) return GRAD_GREEN;
+        if (mspt <= 50) return GRAD_YELLOW;
+        return GRAD_RED;
+    }
+    private static String pingGradient(final int ping) {
+        if (ping < 0) return GRAD_PURPLE;
+        if (ping <= 80) return GRAD_GREEN;
+        if (ping <= 160) return GRAD_YELLOW;
+        return GRAD_RED;
+    }
+    private static String chunkHotGradient(final long chunkHot) {
+        if (chunkHot < 0) return GRAD_PURPLE;
+        if (chunkHot <= 300_000L) return GRAD_GREEN;
+        if (chunkHot <= 500_000L) return GRAD_YELLOW;
+        return GRAD_RED;
+    }
+    private static String utilGradient(final double util) {
+        if (util > 100) return GRAD_PURPLE;
+        if (util >= 70) return GRAD_RED;
+        if (util >= 50) return GRAD_YELLOW;
+        return GRAD_GREEN;
+    }
+    private static String tempGradient(final double tempC) {
+        if (tempC < 73.0D) return GRAD_GREEN;
+        if (tempC < 80.0D) return GRAD_YELLOW;
+        return GRAD_RED;
+    }
+    private static String clockGradient(final double clockGhz) {
+        if (clockGhz >= 4.0D) return GRAD_GREEN;
+        if (clockGhz >= 2.5D) return GRAD_YELLOW;
+        return GRAD_RED;
+    }
+    private static BossBar.Color barColorForGrad(final String grad) {
+        if (GRAD_GREEN.equals(grad)) return BossBar.Color.GREEN;
+        if (GRAD_YELLOW.equals(grad)) return BossBar.Color.YELLOW;
+        if (GRAD_PURPLE.equals(grad)) return BossBar.Color.PURPLE;
+        return BossBar.Color.RED;
+    }
+
+    // --- CPU temperature detection ---
+    private static final boolean IS_WINDOWS = System.getProperty("os.name", "").toLowerCase(Locale.ROOT).contains("win");
+    private static final boolean LINUX_TEMP_AVAILABLE;
+    private static final Path LINUX_TEMP_PATH;
+    private static boolean warnedTempFail = false;
+    private static boolean warnedClockFail = false;
+    static {
+        boolean avail = false;
+        Path foundPath = null;
+        try {
+            if (!IS_WINDOWS) {
+                final Path hwmonDir = Path.of("/sys/class/hwmon");
+                if (Files.isDirectory(hwmonDir)) {
+                    try (var stream = Files.newDirectoryStream(hwmonDir, "hwmon*")) {
+                        for (Path dir : stream) {
+                            Path nameFile = dir.resolve("name");
+                            if (Files.isReadable(nameFile)) {
+                                String name = Files.readString(nameFile).trim().toLowerCase(Locale.ROOT);
+                                if (name.contains("k10temp") || name.contains("coretemp") || name.contains("cpu") || name.contains("zenpower")) {
+                                    for (int t = 1; t <= 8; t++) {
+                                        Path p = dir.resolve("temp" + t + "_input");
+                                        if (Files.isReadable(p)) {
+                                            try {
+                                                Long.parseLong(Files.readString(p).trim());
+                                                foundPath = p;
+                                                avail = true;
+                                                break;
+                                            } catch (Throwable ignored) {}
+                                        }
+                                    }
+                                }
+                            }
+                            if (avail) break;
+                        }
+                    }
+                }
+                if (!avail) {
+                    final Path zone0 = Path.of("/sys/class/thermal/thermal_zone0/temp");
+                    if (Files.isReadable(zone0)) {
+                        try {
+                            Long.parseLong(Files.readString(zone0).trim());
+                            foundPath = zone0;
+                            avail = true;
+                        } catch (Throwable ignored) {}
+                    }
+                }
+                if (!avail && Files.isDirectory(hwmonDir)) {
+                    try (var stream = Files.newDirectoryStream(hwmonDir, "hwmon*")) {
+                        for (Path dir : stream) {
+                            Path nameFile = dir.resolve("name");
+                            String name = "";
+                            if (Files.isReadable(nameFile)) {
+                                name = Files.readString(nameFile).trim().toLowerCase(Locale.ROOT);
+                            }
+                            if (name.contains("nvme") || name.contains("amdgpu") || name.contains("nouveau") || name.contains("radeon")) {
+                                continue;
+                            }
+                            for (int t = 1; t <= 8; t++) {
+                                Path p = dir.resolve("temp" + t + "_input");
+                                if (Files.isReadable(p)) {
+                                    try {
+                                        Long.parseLong(Files.readString(p).trim());
+                                        foundPath = p;
+                                        avail = true;
+                                        break;
+                                    } catch (Throwable ignored) {}
+                                }
+                            }
+                            if (avail) break;
+                        }
+                    }
+                }
+            }
+        } catch (final Throwable ignored) {}
+        LINUX_TEMP_PATH = foundPath;
+        LINUX_TEMP_AVAILABLE = avail;
+    }
+
+    // --- CPU clock frequency detection ---
+    private static final Path LINUX_FREQ_MAX_PATH = Path.of("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq");
+    private static final Path LINUX_CPUINFO_PATH = Path.of("/proc/cpuinfo");
+    private static volatile double cachedWinClock = Double.NaN;
+    private static volatile long lastWinClockRead = 0L;
+    private static final long WIN_CLOCK_CACHE_NS = 2_000_000_000L; // cache 2s
+
+    private static double readCpuClockGhz() {
+        if (!IS_WINDOWS) {
+            try {
+                if (Files.isReadable(LINUX_FREQ_MAX_PATH)) {
+                    final long khz = Long.parseLong(Files.readString(LINUX_FREQ_MAX_PATH).trim());
+                    return khz / 1_000_000.0D;
+                }
+                if (Files.isReadable(LINUX_CPUINFO_PATH)) {
+                    for (final String line : Files.readAllLines(LINUX_CPUINFO_PATH)) {
+                        if (line.toLowerCase(Locale.ROOT).startsWith("cpu mhz")) {
+                            final String[] parts = line.split(":", 2);
+                            if (parts.length == 2) {
+                                return Double.parseDouble(parts[1].trim()) / 1000.0D;
+                            }
+                        }
+                    }
+                }
+            } catch (final Throwable t) {
+                if (!warnedClockFail) {
+                    LOGGER.warning("[FoliaStatusBars] Failed to read CPU clock on Linux: " + t.getMessage());
+                    warnedClockFail = true;
+                }
+                return Double.NaN;
+            }
+            if (!warnedClockFail) {
+                LOGGER.warning("[FoliaStatusBars] CPU clock source not found on Linux (/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq or /proc/cpuinfo)");
+                warnedClockFail = true;
+            }
+            return Double.NaN;
+        }
+        final long now = System.nanoTime();
+        if (now - lastWinClockRead < WIN_CLOCK_CACHE_NS && !Double.isNaN(cachedWinClock)) return cachedWinClock;
+        cachedWinClock = readWindowsCpuClockGhz();
+        lastWinClockRead = now;
+        return cachedWinClock;
+    }
+
+    private static double readWindowsCpuClockGhz() {
+        try {
+            final Process p = new ProcessBuilder(
+                "powershell", "-NoProfile", "-Command",
+                "(Get-CimInstance Win32_PerfFormattedData_Counters_ProcessorInformation | Where-Object Name -eq '_Total').ActualFrequency"
+            ).redirectErrorStream(true).start();
+            String line;
+            try (final BufferedReader r = new BufferedReader(new InputStreamReader(p.getInputStream()))) {
+                line = r.readLine();
+            }
+            p.waitFor();
+            if (line != null && !line.isBlank()) {
+                final double mhz = Double.parseDouble(line.trim());
+                return mhz / 1000.0D;
+            }
+        } catch (final Throwable t) {
+            if (!warnedClockFail) {
+                LOGGER.warning("[FoliaStatusBars] Failed to read CPU clock on Windows: " + t.getMessage());
+                warnedClockFail = true;
+            }
+        }
+        return Double.NaN;
+    }
+
+    private static volatile double cachedWinTemp = Double.NaN;
+    private static volatile long lastWinTempRead = 0L;
+    private static final long WIN_TEMP_CACHE_NS = 2_000_000_000L; // cache 2s
+    private static double readCpuTempC() {
+        if (LINUX_TEMP_AVAILABLE) {
+            try {
+                return Long.parseLong(Files.readString(LINUX_TEMP_PATH).trim()) / 1000.0D;
+            } catch (final Throwable t) {
+                if (!warnedTempFail) {
+                    LOGGER.warning("[FoliaStatusBars] Failed to read CPU temp on Linux: " + t.getMessage());
+                    warnedTempFail = true;
+                }
+                return Double.NaN;
+            }
+        } else if (!IS_WINDOWS && !warnedTempFail) {
+            LOGGER.warning("[FoliaStatusBars] CPU temperature source not found on Linux (/sys/class/hwmon or /sys/class/thermal).");
+            warnedTempFail = true;
+        }
+        if (IS_WINDOWS) {
+            final long now = System.nanoTime();
+            if (now - lastWinTempRead < WIN_TEMP_CACHE_NS && !Double.isNaN(cachedWinTemp)) return cachedWinTemp;
+            cachedWinTemp = readWindowsCpuTemp();
+            lastWinTempRead = now;
+            return cachedWinTemp;
+        }
+        return Double.NaN;
+    }
+
+    private static double readWindowsCpuTemp() {
+        try {
+            final Process p = new ProcessBuilder(
+                "powershell", "-NoProfile", "-Command",
+                "(Get-CimInstance -Namespace root/WMI -ClassName MSAcpi_ThermalZoneTemperature -ErrorAction SilentlyContinue | Select-Object -First 1).CurrentTemperature"
+            ).redirectErrorStream(true).start();
+            String line;
+            try (final BufferedReader r = new BufferedReader(new InputStreamReader(p.getInputStream()))) {
+                line = r.readLine();
+            }
+            p.waitFor();
+            if (line != null && !line.isBlank()) {
+                // WMI returns tenths of Kelvin
+                return (Double.parseDouble(line.trim()) / 10.0D) - 273.15D;
+            }
+        } catch (final Throwable t) {
+            if (!warnedTempFail) {
+                LOGGER.warning("[FoliaStatusBars] Failed to read CPU temperature on Windows: " + t.getMessage());
+                warnedTempFail = true;
+            }
+        }
+        if (!warnedTempFail) {
+            LOGGER.warning("[FoliaStatusBars] CPU temperature unavailable on Windows (WMI MSAcpi_ThermalZoneTemperature not supported or requires elevated privileges). Displaying N/A.");
+            warnedTempFail = true;
+        }
+        return Double.NaN;
+    }
+
+    private static void remove(final Player player, final BarType type) {
+        final BossBar bar = BARS.get(type).remove(player.getUniqueId());
+        if (bar != null) player.hideBossBar(bar);
+    }
+
+    private static void update(final Player player, final BarType type, final BossBar bar) {
+        final MiniMessage mm = MiniMessage.miniMessage();
+        if (type == BarType.CPU) {
+            updateCpuMetric();
+            final int procs = Runtime.getRuntime().availableProcessors();
+            final double maxPercent = Math.max(1.0D, procs * 100.0D);
+            final double ratio = Math.min(1.0D, Math.max(0.0D, smoothedCpuPercent / maxPercent));
+            final String g = cpuGradient(ratio);
+            final StringBuilder sb = new StringBuilder();
+            sb.append("<gray>CPU<gray>:</gray> ").append(g).append(String.format(Locale.ROOT, "%.2f", smoothedCpuPercent)).append(GRAD_END);
+            sb.append("/").append(g).append(String.format(Locale.ROOT, "%.2f", maxPercent)).append(GRAD_END);
+            sb.append(" (").append(g).append(String.format(Locale.ROOT, "%.0f%%", ratio * 100.0D)).append(GRAD_END).append(")");
+            final double clockGhz = readCpuClockGhz();
+            sb.append(" Clock<gray>:</gray> ");
+            if (!Double.isNaN(clockGhz)) {
+                final String gC = clockGradient(clockGhz);
+                sb.append(gC).append(String.format(Locale.ROOT, "%.2fGHz", clockGhz)).append(GRAD_END);
+            } else {
+                sb.append("<dark_gray>N/A</dark_gray>");
+            }
+            final double tempC = readCpuTempC();
+            sb.append(" Temp<gray>:</gray> ");
+            if (!Double.isNaN(tempC)) {
+                final String gT = tempGradient(tempC);
+                sb.append(gT).append(String.format(Locale.ROOT, "%.1f°C", tempC)).append(GRAD_END);
+            } else {
+                sb.append("<dark_gray>N/A</dark_gray>");
+            }
+            bar.name(mm.deserialize(sb.toString())).progress((float) ratio).color(barColorForGrad(g));
+            return;
+        }
+        if (type == BarType.MEMORY) {
+            final MemoryUsage heap = ManagementFactory.getMemoryMXBean().getHeapMemoryUsage();
+            final long used = heap.getUsed();
+            final long max = heap.getMax();
+            final double percent = Math.clamp((double) used / max, 0.0, 1.0);
+            final String gUsed = memGradient(percent);
+            final String usedStr = gUsed + String.format(Locale.ROOT, "%.2fGB", used / 1073741824.0D) + GRAD_END;
+            final String maxStr = GRAD_GREEN + String.format(Locale.ROOT, "%.2fGB", max / 1073741824.0D) + GRAD_END;
+            final Component msg = mm.deserialize("<gray>Memory usage<gray>:</gray> " + usedStr + "<yellow>/</yellow>" + maxStr);
+            bar.name(msg).progress((float) percent).color(barColorForGrad(gUsed));
+            return;
+        }
+        final ThreadedRegionizer.ThreadedRegion<TickRegions.TickRegionData, TickRegions.TickRegionSectionData> region = TickRegionScheduler.getCurrentRegion();
+        if (region == null) return;
+        final TickRegions.TickRegionData data = region.getData();
+        final TickData.TickReportData report = data.getRegionSchedulingHandle().getTickReport5s(System.nanoTime());
+        if (report == null) return;
+        final double utilisation = report.utilisation();
+        if (type == BarType.TPS) {
+            final double tps = report.tpsData().segmentAll().average();
+            final double mspt = report.timePerTickData().segmentAll().average() / 1.0E6;
+            final String gTps = tpsGradient(tps);
+            final String gMspt = msptGradient(mspt);
+            final net.minecraft.server.level.ServerPlayer handle = ((org.bukkit.craftbukkit.entity.CraftPlayer)player).getHandle();
+            final int ping = handle.connection.latency();
+            final String gPing = pingGradient(ping);
+            final long chunkHot = handle.folia$getNearbyChunkHot();
+            final String gChunk = chunkHotGradient(chunkHot);
+            final Component msg = mm.deserialize(
+                "<gray>TPS<gray>:</gray> " + gTps + String.format("%.2f", tps) + GRAD_END
+                + " MSPT<gray>:</gray> " + gMspt + String.format("%.2f", mspt) + GRAD_END
+                + " Ping<gray>:</gray> " + gPing + ping + "ms" + GRAD_END
+                + " ChunkHot<gray>:</gray> " + gChunk + chunkHot + GRAD_END
+            );
+            bar.name(msg).progress((float) Math.clamp(mspt / 50.0, 0.0, 1.0)).color(barColorForGrad(gTps));
+        } else {
+            final TickRegions.RegionStats stats = data.getRegionStats();
+            final double utilisationPercent = utilisation * 100.0;
+            final String formattedUtil = String.format(Locale.ROOT, "%.1f", utilisationPercent);
+            final String gUtil = utilGradient(utilisationPercent);
+            final Component msg = mm.deserialize(
+                "<gray>Util<gray>:</gray> " + gUtil + formattedUtil + "%" + GRAD_END
+                + " Chunks<gray>:</gray> " + GRAD_GREEN + stats.getChunkCount() + GRAD_END
+                + " Players<gray>:</gray> " + GRAD_GREEN + stats.getPlayerCount() + GRAD_END
+                + " Entities<gray>:</gray> " + GRAD_GREEN + stats.getEntityCount() + GRAD_END
+            );
+            bar.name(msg).progress((float) Math.clamp(utilisation, 0.0, 1.0)).color(barColorForGrad(gUtil));
+        }
+    }
+
+    private enum BarType {
+        TPS("tpsbar"), MEMORY("membar"), REGION("regionbar"), CPU("cpubar");
+        private final NamespacedKey key;
+        BarType(final String key) { this.key = new NamespacedKey("folia", key); }
+    }
+    private static double updateCpuMetric() {
+        final int procs = Runtime.getRuntime().availableProcessors();
+        double raw = 0.0;
+        try {
+            final java.lang.management.OperatingSystemMXBean baseOs = ManagementFactory.getOperatingSystemMXBean();
+            if (baseOs instanceof com.sun.management.OperatingSystemMXBean os) {
+                final long procCpuTime = os.getProcessCpuTime();
+                final long now = System.nanoTime();
+                if (procCpuTime >= 0L) {
+                    if (lastProcCpuTime >= 0.0 && lastWallClockTime >= 0L) {
+                        final long cpuDiff = procCpuTime - (long) lastProcCpuTime;
+                        final long wallDiff = now - lastWallClockTime;
+                        if (wallDiff > 0L && cpuDiff >= 0L) {
+                            raw = ((double) cpuDiff / (double) wallDiff) * 100.0D;
+                        }
+                    }
+                    lastProcCpuTime = procCpuTime;
+                    lastWallClockTime = now;
+                }
+            }
+        } catch (final Throwable ignored) {}
+        if (!hasSmoothed) {
+            smoothedCpuPercent = raw;
+            hasSmoothed = true;
+        } else {
+            smoothedCpuPercent = (0.3D * raw) + ((1.0D - 0.3D) * smoothedCpuPercent);
+        }
+        return smoothedCpuPercent;
+    }
+
+    public static double getCpuPercent() {
+        updateCpuMetric();
+        return smoothedCpuPercent;
+    }
+
+    public static double getCpuRatio() {
+        updateCpuMetric();
+        final int procs = Runtime.getRuntime().availableProcessors();
+        final double maxPercent = Math.max(1.0D, procs * 100.0D);
+        return Math.min(1.0D, Math.max(0.0D, smoothedCpuPercent / maxPercent));
+    }
+
+    public static double getCpuClockGhz() {
+        return readCpuClockGhz();
+    }
+
+    public static double getCpuTempC() {
+        return readCpuTempC();
+    }
+
+    private static final class PapiHook {
+        static void register() {
+            try {
+                new me.clip.placeholderapi.expansion.PlaceholderExpansion() {
+                    @Override
+                    public @NotNull String getIdentifier() {
+                        return "folia";
+                    }
+
+                    @Override
+                    public @NotNull String getAuthor() {
+                        return "Folia";
+                    }
+
+                    @Override
+                    public @NotNull String getVersion() {
+                        return "1.0";
+                    }
+
+                    @Override
+                    public boolean persist() {
+                        return true;
+                    }
+
+                    @Override
+                    public String onRequest(org.bukkit.OfflinePlayer player, @NotNull String params) {
+                        final String lower = params.toLowerCase(Locale.ROOT);
+                        final double ratio = FoliaStatusBarCommand.getCpuRatio();
+                        final String cpuGrad = cpuGradient(ratio);
+                        return switch (lower) {
+                            case "cpu_percent", "cpubar_percent", "cpu_pct", "cpubar_pct" ->
+                                cpuGrad + String.format(Locale.ROOT, "%.0f%%", ratio * 100.0D) + GRAD_END;
+                            case "cpu_percent_raw", "cpubar_percent_raw", "cpu_percent_plain" ->
+                                String.format(Locale.ROOT, "%.0f%%", ratio * 100.0D);
+                            case "cpu_percent_num" ->
+                                String.format(Locale.ROOT, "%.2f", ratio * 100.0D);
+                            case "cpu", "cpu_process", "cpubar_cpu" ->
+                                cpuGrad + String.format(Locale.ROOT, "%.2f", FoliaStatusBarCommand.getCpuPercent()) + GRAD_END;
+                            case "cpu_raw", "cpu_process_raw" ->
+                                String.format(Locale.ROOT, "%.2f", FoliaStatusBarCommand.getCpuPercent());
+                            case "cpu_clock", "cpubar_clock" -> {
+                                final double clock = FoliaStatusBarCommand.getCpuClockGhz();
+                                if (Double.isNaN(clock)) yield "<dark_gray>N/A</dark_gray>";
+                                yield clockGradient(clock) + String.format(Locale.ROOT, "%.2fGHz", clock) + GRAD_END;
+                            }
+                            case "cpu_clock_raw" -> {
+                                final double clock = FoliaStatusBarCommand.getCpuClockGhz();
+                                yield Double.isNaN(clock) ? "N/A" : String.format(Locale.ROOT, "%.2fGHz", clock);
+                            }
+                            case "cpu_temp", "cpubar_temp" -> {
+                                final double temp = FoliaStatusBarCommand.getCpuTempC();
+                                if (Double.isNaN(temp)) yield "<dark_gray>N/A</dark_gray>";
+                                yield tempGradient(temp) + String.format(Locale.ROOT, "%.1f°C", temp) + GRAD_END;
+                            }
+                            case "cpu_temp_raw" -> {
+                                final double temp = FoliaStatusBarCommand.getCpuTempC();
+                                yield Double.isNaN(temp) ? "N/A" : String.format(Locale.ROOT, "%.1f°C", temp);
+                            }
+                            case "region_tps", "tps_region", "tps" -> formatRegionTps(player, true);
+                            case "region_tps_raw", "tps_region_raw", "tps_raw" -> formatRegionTps(player, false);
+                            default -> null;
+                        };
+                    }
+
+                    private String formatRegionTps(org.bukkit.OfflinePlayer offlinePlayer, boolean color) {
+                        if (offlinePlayer == null || !offlinePlayer.isOnline()) return "*20.0";
+                        final Player p = offlinePlayer.getPlayer();
+                        if (p == null) return "*20.0";
+                        final double[] tpsArr = Bukkit.getRegionTPS(p.getLocation());
+                        if (tpsArr == null || tpsArr.length == 0) return "*20.0";
+                        final double tps = Math.min(20.0D, tpsArr[0]);
+                        final String formatted = String.format(Locale.ROOT, "%.2f", tps);
+                        if (!color) return formatted;
+                        return tpsGradient(tps) + formatted + GRAD_END;
+                    }
+                }.register();
+            } catch (final Throwable ignored) {}
+        }
+    }
+}
