+        this.commandMap.register("folia", io.papermc.paper.threadedregions.FoliaStatusBarCommand.ramBarCommand()); // Folia - status bars
+        this.commandMap.register("folia", io.papermc.paper.threadedregions.FoliaStatusBarCommand.regionBarCommand()); // Folia - status bars
