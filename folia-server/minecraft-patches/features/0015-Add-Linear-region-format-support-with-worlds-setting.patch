+package io.papermc.paper.linear;
+
+import org.slf4j.Logger;
+import com.mojang.logging.LogUtils;
+import org.spongepowered.configurate.CommentedConfigurationNode;
+import org.spongepowered.configurate.ConfigurateException;
+import org.spongepowered.configurate.ConfigurationNode;
+import org.spongepowered.configurate.loader.HeaderMode;
+import org.spongepowered.configurate.yaml.NodeStyle;
+import org.spongepowered.configurate.yaml.YamlConfigurationLoader;
+
+import java.io.IOException;
+import java.nio.file.AtomicMoveNotSupportedException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * World region format configuration manager (config/worlds-settings.yml).
+ */
+public final class WorldsSettings {
+    private static final Logger LOGGER = LogUtils.getLogger();
+    public static final String FILE_NAME = "worlds-settings.yml";
+    public static final int CURRENT_CONFIG_VERSION = 1;
+
+    public record ConversionSettings(
+        boolean automatic,
+        int countdownSeconds,
+        boolean backupEnabled,
+        String backupDirectory
+    ) {}
+
+    public record WorldFormatSetting(
+        RegionFormat regionFormat,
+        int linearCompressionLevel,
+        ConversionSettings conversion
+    ) {}
+
+    private static volatile WorldsSettings instance;
+
+    private final Path configFile;
+    private final WorldFormatSetting defaults;
+    private final Map<String, WorldFormatSetting> worldSettings = new HashMap<>();
+    private final Map<Path, WorldFormatSetting> resolvedPathCache = new ConcurrentHashMap<>();
+
+    private WorldsSettings(final Path configFile, final WorldFormatSetting defaults, final Map<String, WorldFormatSetting> worldSettings) {
+        this.configFile = configFile;
+        this.defaults = defaults;
+        this.worldSettings.putAll(worldSettings);
+    }
+
+    public static WorldsSettings get() {
+        return instance;
+    }
+
+    public static synchronized WorldsSettings load(final Path configDir) {
+        final Path path = configDir.resolve(FILE_NAME);
+        try {
+            if (!Files.exists(configDir)) {
+                Files.createDirectories(configDir);
+            }
+
+            final YamlConfigurationLoader loader = YamlConfigurationLoader.builder()
+                .path(path)
+                .nodeStyle(NodeStyle.BLOCK)
+                .headerMode(HeaderMode.PRESET)
+                .indent(2)
+                .build();
+
+            CommentedConfigurationNode root;
+            boolean isNewFile = !Files.exists(path);
+
+            if (isNewFile) {
+                root = loader.createNode();
+            } else {
+                root = loader.load();
+            }
+
+            // Check config-version
+            final ConfigurationNode versionNode = root.node("config-version");
+            if (!versionNode.virtual()) {
+                final int version = versionNode.getInt(CURRENT_CONFIG_VERSION);
+                if (version > CURRENT_CONFIG_VERSION) {
+                    LOGGER.warn("Unknown newer config-version {} in {} (expected <= {}). Keeping existing configuration without overwriting.",
+                        version, path.toAbsolutePath(), CURRENT_CONFIG_VERSION);
+                }
+            } else {
+                versionNode.set(CURRENT_CONFIG_VERSION);
+            }
+
+            // Set file header comments
+            root.comment("""
+                Worlds Settings Configuration
+                Configures storage region formats (MCA vs Linear) and automatic startup conversion.
+                """);
+
+            // Defaults section
+            final CommentedConfigurationNode defaultsNode = root.node("defaults");
+            defaultsNode.comment("""
+                Default region format settings applied to all worlds unless overridden below.
+                """);
+
+            final CommentedConfigurationNode defaultFormatNode = defaultsNode.node("region-format");
+            if (defaultFormatNode.virtual()) {
+                defaultFormatNode.set("MCA");
+                defaultFormatNode.comment("Storage format: MCA (standard Minecraft anvil format) or LINEAR (Linear v2 format)");
+            }
+
+            final CommentedConfigurationNode defaultCompressionNode = defaultsNode.node("linear-compression-level");
+            if (defaultCompressionNode.virtual()) {
+                defaultCompressionNode.set(3);
+                defaultCompressionNode.comment("Zstandard compression level for Linear format (1-22, recommended: 1-6, default: 3)");
+            }
+
+            final CommentedConfigurationNode defaultConversionNode = defaultsNode.node("conversion");
+            defaultConversionNode.comment("Conversion settings when migrating between MCA and Linear format");
+
+            final CommentedConfigurationNode defaultAutoNode = defaultConversionNode.node("automatic");
+            if (defaultAutoNode.virtual()) {
+                defaultAutoNode.set(false);
+                defaultAutoNode.comment("Automatically convert existing worlds to target format on server startup");
+            }
+
+            final CommentedConfigurationNode defaultCountdownNode = defaultConversionNode.node("countdown-seconds");
+            if (defaultCountdownNode.virtual()) {
+                defaultCountdownNode.set(30);
+                defaultCountdownNode.comment("Safety countdown in seconds before conversion begins (abortable via Ctrl+C / stop)");
+            }
+
+            final CommentedConfigurationNode defaultBackupNode = defaultConversionNode.node("backup");
+            defaultBackupNode.comment("Backup settings before performing format conversion");
+
+            final CommentedConfigurationNode defaultBackupEnabledNode = defaultBackupNode.node("enabled");
+            if (defaultBackupEnabledNode.virtual()) {
+                defaultBackupEnabledNode.set(true);
+                defaultBackupEnabledNode.comment("Create a full backup of the world folder before converting");
+            }
+
+            final CommentedConfigurationNode defaultBackupDirNode = defaultBackupNode.node("directory");
+            if (defaultBackupDirNode.virtual()) {
+                defaultBackupDirNode.set("backups/world-conversion");
+                defaultBackupDirNode.comment("Directory where world conversion backups are saved");
+            }
+
+            // Worlds overrides section
+            final CommentedConfigurationNode worldsNode = root.node("worlds");
+            if (worldsNode.virtual()) {
+                worldsNode.comment("""
+                    World-specific overrides. Key is the actual world folder name (e.g. 'world', 'world_nether', 'world_the_end').
+                    Example:
+                      world:
+                        region-format: LINEAR
+                        conversion:
+                          automatic: true
+                    """);
+            }
+
+            // Parse defaults
+            final RegionFormat defaultFormat = RegionFormat.fromString(defaultFormatNode.getString("MCA"));
+            final int defaultCompression = Math.max(1, Math.min(22, defaultCompressionNode.getInt(3)));
+            final boolean defaultAuto = defaultAutoNode.getBoolean(false);
+            final int defaultCountdown = Math.max(0, defaultCountdownNode.getInt(30));
+            final boolean defaultBackupEnabled = defaultBackupEnabledNode.getBoolean(true);
+            final String defaultBackupDir = defaultBackupDirNode.getString("backups/world-conversion");
+
+            final ConversionSettings defaultConv = new ConversionSettings(defaultAuto, defaultCountdown, defaultBackupEnabled, defaultBackupDir);
+            final WorldFormatSetting defaultSetting = new WorldFormatSetting(defaultFormat, defaultCompression, defaultConv);
+
+            // Parse world overrides
+            final Map<String, WorldFormatSetting> parsedWorlds = new HashMap<>();
+            if (!worldsNode.virtual() && worldsNode.isMap()) {
+                for (final Map.Entry<Object, ? extends ConfigurationNode> entry : worldsNode.childrenMap().entrySet()) {
+                    final String worldName = String.valueOf(entry.getKey());
+                    final ConfigurationNode wNode = entry.getValue();
+
+                    final RegionFormat wFormat = wNode.node("region-format").virtual()
+                        ? defaultFormat
+                        : RegionFormat.fromString(wNode.node("region-format").getString());
+
+                    final int wCompression = wNode.node("linear-compression-level").virtual()
+                        ? defaultCompression
+                        : Math.max(1, Math.min(22, wNode.node("linear-compression-level").getInt(defaultCompression)));
+
+                    final ConfigurationNode wConvNode = wNode.node("conversion");
+                    final boolean wAuto = wConvNode.node("automatic").virtual()
+                        ? defaultAuto
+                        : wConvNode.node("automatic").getBoolean(defaultAuto);
+
+                    final int wCountdown = wConvNode.node("countdown-seconds").virtual()
+                        ? defaultCountdown
+                        : Math.max(0, wConvNode.node("countdown-seconds").getInt(defaultCountdown));
+
+                    final ConfigurationNode wBackupNode = wConvNode.node("backup");
+                    final boolean wBackupEnabled = wBackupNode.node("enabled").virtual()
+                        ? defaultBackupEnabled
+                        : wBackupNode.node("enabled").getBoolean(defaultBackupEnabled);
+
+                    final String wBackupDir = wBackupNode.node("directory").virtual()
+                        ? defaultBackupDir
+                        : wBackupNode.node("directory").getString(defaultBackupDir);
+
+                    final ConversionSettings wConv = new ConversionSettings(wAuto, wCountdown, wBackupEnabled, wBackupDir);
+                    parsedWorlds.put(worldName, new WorldFormatSetting(wFormat, wCompression, wConv));
+                }
+            }
+
+            // Safe atomic write if newly created or missing default keys were added
+            safeSave(loader, root, path);
+
+            instance = new WorldsSettings(path, defaultSetting, parsedWorlds);
+            return instance;
+        } catch (final Exception ex) {
+            LOGGER.error("Failed to load worlds-settings.yml at {}", path.toAbsolutePath(), ex);
+            throw new RuntimeException("Failed to load worlds-settings.yml: " + ex.getMessage(), ex);
+        }
+    }
+
+    private static void safeSave(final YamlConfigurationLoader loader, final ConfigurationNode root, final Path targetPath) {
+        final Path tempPath = targetPath.resolveSibling(targetPath.getFileName().toString() + ".tmp");
+        try {
+            final YamlConfigurationLoader tempLoader = YamlConfigurationLoader.builder()
+                .path(tempPath)
+                .nodeStyle(NodeStyle.BLOCK)
+                .headerMode(HeaderMode.PRESET)
+                .indent(2)
+                .build();
+            tempLoader.save(root);
+
+            try {
+                Files.move(tempPath, targetPath, StandardCopyOption.ATOMIC_MOVE, StandardCopyOption.REPLACE_EXISTING);
+            } catch (final AtomicMoveNotSupportedException ex) {
+                Files.move(tempPath, targetPath, StandardCopyOption.REPLACE_EXISTING);
+            }
+        } catch (final IOException ex) {
+            LOGGER.error("Failed to safely write configuration to {}", targetPath.toAbsolutePath(), ex);
+            try {
+                Files.deleteIfExists(tempPath);
+            } catch (final IOException ignored) {}
+        }
+    }
+
+    public WorldFormatSetting getDefaults() {
+        return this.defaults;
+    }
+
+    public WorldFormatSetting getForWorld(final String worldName) {
+        if (worldName != null && this.worldSettings.containsKey(worldName)) {
+            return this.worldSettings.get(worldName);
+        }
+        return this.defaults;
+    }
+
+    public WorldFormatSetting getForPath(final Path folder) {
+        return this.resolvedPathCache.computeIfAbsent(folder, f -> {
+            // Check folder name and parent folders against worldSettings
+            Path curr = f;
+            while (curr != null) {
+                final Path fileName = curr.getFileName();
+                if (fileName != null) {
+                    final String name = fileName.toString();
+                    if (this.worldSettings.containsKey(name)) {
+                        return this.worldSettings.get(name);
+                    }
+                }
+                curr = curr.getParent();
+            }
+            return this.defaults;
+        });
+    }
+
+    public Map<String, WorldFormatSetting> getWorldSettings() {
+        return this.worldSettings;
+    }
+}
