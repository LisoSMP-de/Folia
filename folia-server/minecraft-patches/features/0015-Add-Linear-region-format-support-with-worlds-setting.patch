diff --git a/io/papermc/paper/linear/LinearRegionFile.java b/io/papermc/paper/linear/LinearRegionFile.java
new file mode 100644
index 0000000000000000000000000000000000000000..62fabc5719e58870b55970939eb566f9c153c65c
--- /dev/null
+++ b/io/papermc/paper/linear/LinearRegionFile.java
@@ -0,0 +1,622 @@
+package io.papermc.paper.linear;
+
+import ca.spottedleaf.moonrise.patches.chunk_system.io.MoonriseRegionFileIO;
+import com.github.luben.zstd.ZstdInputStream;
+import com.github.luben.zstd.ZstdOutputStream;
+import com.mojang.logging.LogUtils;
+import net.jpountz.lz4.LZ4Compressor;
+import net.jpountz.lz4.LZ4Factory;
+import net.jpountz.lz4.LZ4FastDecompressor;
+import net.minecraft.nbt.CompoundTag;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.chunk.storage.RegionFileVersion;
+import net.minecraft.world.level.chunk.storage.RegionStorageInfo;
+import org.jspecify.annotations.Nullable;
+import org.slf4j.Logger;
+
+import java.io.*;
+import java.nio.ByteBuffer;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardCopyOption;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.locks.LockSupport;
+import java.util.concurrent.locks.ReentrantLock;
+
+/**
+ * Linear Region File implementation (Linear v2 specification).
+ * Uses Zstandard bucket compression and LZ4 in-memory chunk cache.
+ */
+public class LinearRegionFile implements IRegionFile {
+    private static final long SUPERBLOCK = 0xc3ff13183cca9d9aL;
+    private static final byte VERSION = 3;
+    private static final Logger LOGGER = LogUtils.getLogger();
+
+    public static final int SAVE_THREAD_MAX_COUNT = 6;
+    public static final int SAVE_DELAY_MS = 100;
+    public static final boolean USE_VIRTUAL_THREAD = true;
+    private static final Object saveLock = new Object();
+    private static int activeSaveThreads = 0;
+
+    private byte[][] bucketBuffers;
+    private final byte[][] buffer = new byte[1024][];
+    private final int[] bufferUncompressedSize = new int[1024];
+
+    private final long[] chunkTimestamps = new long[1024];
+    private final Object markedToSaveLock = new Object();
+
+    private final LZ4Compressor compressor;
+    private final LZ4FastDecompressor decompressor;
+
+    private boolean markedToSave = false;
+    private volatile boolean close = false;
+
+    public final ReentrantLock fileLock = new ReentrantLock(true);
+    public final Path regionFile;
+
+    private final int compressionLevel;
+    private int gridSize = 8;
+    private int bucketSize = 4;
+    private final Thread bindThread;
+    private boolean regionFileOpen = false;
+
+    public LinearRegionFile(final RegionStorageInfo storageKey, final Path path, final Path directory, final boolean dsync, final int compressionLevel) throws IOException {
+        this(storageKey, path, directory, RegionFileVersion.getSelected(), dsync, compressionLevel);
+    }
+
+    public LinearRegionFile(final RegionStorageInfo storageKey, final Path path, final Path directory, final RegionFileVersion compressionFormat, final boolean dsync, final int compressionLevel) throws IOException {
+        this.regionFile = path;
+        this.compressionLevel = compressionLevel;
+
+        this.compressor = LZ4Factory.fastestInstance().fastCompressor();
+        this.decompressor = LZ4Factory.fastestInstance().fastDecompressor();
+
+        final Runnable flushCheck = () -> {
+            while (!this.close) {
+                synchronized (saveLock) {
+                    if (this.markedToSave && activeSaveThreads < SAVE_THREAD_MAX_COUNT) {
+                        activeSaveThreads++;
+                        final Runnable flushOperation = () -> {
+                            try {
+                                this.flush();
+                            } catch (final IOException ex) {
+                                LOGGER.error("Region file {} flush failed", this.regionFile.toAbsolutePath(), ex);
+                            } finally {
+                                synchronized (saveLock) {
+                                    activeSaveThreads--;
+                                }
+                            }
+                        };
+
+                        final Thread saveThread = USE_VIRTUAL_THREAD ?
+                            Thread.ofVirtual().name("Linear IO - " + LinearRegionFile.this.hashCode()).unstarted(flushOperation) :
+                            Thread.ofPlatform().name("Linear IO - " + LinearRegionFile.this.hashCode()).unstarted(flushOperation);
+                        saveThread.setPriority(Thread.NORM_PRIORITY - 3);
+                        saveThread.start();
+                    }
+                }
+                LockSupport.parkNanos(TimeUnit.MILLISECONDS.toNanos(SAVE_DELAY_MS));
+            }
+        };
+
+        this.bindThread = USE_VIRTUAL_THREAD ?
+            Thread.ofVirtual().name("Linear IO Schedule - " + this.hashCode()).unstarted(flushCheck) :
+            Thread.ofPlatform().name("Linear IO Schedule - " + this.hashCode()).unstarted(flushCheck);
+    }
+
+    public Path getRegionFile() {
+        return this.regionFile;
+    }
+
+    public ReentrantLock getFileLock() {
+        return this.fileLock;
+    }
+
+    private int chunkToBucketIdx(final int chunkX, final int chunkZ) {
+        final int bx = chunkX / this.bucketSize;
+        final int bz = chunkZ / this.bucketSize;
+        return bx * this.gridSize + bz;
+    }
+
+    private void openBucket(int chunkX, int chunkZ) {
+        chunkX = Math.floorMod(chunkX, 32);
+        chunkZ = Math.floorMod(chunkZ, 32);
+        final int idx = this.chunkToBucketIdx(chunkX, chunkZ);
+
+        if (this.bucketBuffers == null) {
+            return;
+        }
+        if (this.bucketBuffers[idx] != null) {
+            try {
+                final ByteArrayInputStream bucketByteStream = new ByteArrayInputStream(this.bucketBuffers[idx]);
+                final ZstdInputStream zstdStream = new ZstdInputStream(bucketByteStream);
+                final ByteBuffer bucketBuffer = ByteBuffer.wrap(zstdStream.readAllBytes());
+
+                final int bx = chunkX / this.bucketSize;
+                final int bz = chunkZ / this.bucketSize;
+
+                for (int cx = 0; cx < 32 / this.gridSize; cx++) {
+                    for (int cz = 0; cz < 32 / this.gridSize; cz++) {
+                        final int chunkIndex = (bx * (32 / this.gridSize) + cx) + (bz * (32 / this.gridSize) + cz) * 32;
+
+                        final int chunkSize = bucketBuffer.getInt();
+                        final long timestamp = bucketBuffer.getLong();
+                        this.chunkTimestamps[chunkIndex] = timestamp;
+
+                        if (chunkSize > 0) {
+                            final byte[] chunkData = new byte[chunkSize - 8];
+                            bucketBuffer.get(chunkData);
+
+                            final int maxCompressedLength = this.compressor.maxCompressedLength(chunkData.length);
+                            final byte[] compressed = new byte[maxCompressedLength];
+                            final int compressedLength = this.compressor.compress(chunkData, 0, chunkData.length, compressed, 0, maxCompressedLength);
+                            final byte[] finalCompressed = new byte[compressedLength];
+                            System.arraycopy(compressed, 0, finalCompressed, 0, compressedLength);
+
+                            this.buffer[chunkIndex] = finalCompressed;
+                            this.bufferUncompressedSize[chunkIndex] = chunkData.length;
+                        }
+                    }
+                }
+            } catch (final IOException ex) {
+                throw new RuntimeException("Region file corrupted: " + this.regionFile + " bucket: " + idx, ex);
+            }
+            this.bucketBuffers[idx] = null;
+        }
+    }
+
+    private synchronized void openRegionFile() {
+        if (this.regionFileOpen) {
+            return;
+        }
+        this.regionFileOpen = true;
+
+        final File file = this.regionFile.toFile();
+        if (!file.canRead()) {
+            this.bindThread.start();
+            return;
+        }
+
+        try {
+            final byte[] fileContent = Files.readAllBytes(this.regionFile);
+            final ByteBuffer buf = ByteBuffer.wrap(fileContent);
+
+            final long superBlock = buf.getLong();
+            if (superBlock != SUPERBLOCK) {
+                throw new RuntimeException("Invalid superblock: " + superBlock + " file " + this.regionFile);
+            }
+
+            final byte version = buf.get();
+            if (version == 1 || version == 2) {
+                this.parseLinearV1(buf);
+            } else if (version == 3) {
+                this.parseLinearV2(buf);
+            } else {
+                throw new RuntimeException("Invalid version: " + version + " file " + this.regionFile);
+            }
+
+            this.bindThread.start();
+        } catch (final IOException e) {
+            throw new RuntimeException("Failed to open region file " + this.regionFile, e);
+        }
+    }
+
+    private void parseLinearV1(final ByteBuffer buf) throws IOException {
+        final int headerSize = 32;
+        final int footerSize = 8;
+
+        // Skip newestTimestamp (Long) + Compression level (Byte) + Chunk count (Short)
+        buf.position(buf.position() + 11);
+
+        final int dataCount = buf.getInt();
+        final long fileLength = this.regionFile.toFile().length();
+        if (fileLength != headerSize + dataCount + footerSize) {
+            throw new IOException("Invalid file length: " + this.regionFile + " " + fileLength + " expected " + (headerSize + dataCount + footerSize));
+        }
+
+        buf.position(buf.position() + 8); // Skip data hash (Long)
+
+        final byte[] rawCompressed = new byte[dataCount];
+        buf.get(rawCompressed);
+
+        final ByteArrayInputStream byteArrayInputStream = new ByteArrayInputStream(rawCompressed);
+        final ZstdInputStream zstdInputStream = new ZstdInputStream(byteArrayInputStream);
+        final ByteBuffer decompressedBuffer = ByteBuffer.wrap(zstdInputStream.readAllBytes());
+
+        final int[] starts = new int[1024];
+        for (int i = 0; i < 1024; i++) {
+            starts[i] = decompressedBuffer.getInt();
+            decompressedBuffer.getInt(); // Skip timestamps
+        }
+
+        for (int i = 0; i < 1024; i++) {
+            if (starts[i] > 0) {
+                final int size = starts[i];
+                final byte[] chunkData = new byte[size];
+                decompressedBuffer.get(chunkData);
+
+                final int maxCompressedLength = this.compressor.maxCompressedLength(size);
+                final byte[] compressed = new byte[maxCompressedLength];
+                final int compressedLength = this.compressor.compress(chunkData, 0, size, compressed, 0, maxCompressedLength);
+                final byte[] finalCompressed = new byte[compressedLength];
+                System.arraycopy(compressed, 0, finalCompressed, 0, compressedLength);
+
+                this.buffer[i] = finalCompressed;
+                this.bufferUncompressedSize[i] = size;
+                this.chunkTimestamps[i] = getTimestamp();
+            }
+        }
+    }
+
+    private void parseLinearV2(final ByteBuffer buf) throws IOException {
+        buf.getLong(); // Skip newestTimestamp (Long)
+        this.gridSize = buf.get();
+        if (this.gridSize != 1 && this.gridSize != 2 && this.gridSize != 4 && this.gridSize != 8 && this.gridSize != 16 && this.gridSize != 32) {
+            throw new RuntimeException("Invalid grid size: " + this.gridSize + " file " + this.regionFile);
+        }
+        this.bucketSize = 32 / this.gridSize;
+
+        buf.getInt(); // Skip region_x (Int)
+        buf.getInt(); // Skip region_z (Int)
+
+        this.deserializeExistenceBitmap(buf);
+
+        while (true) {
+            final byte featureNameLength = buf.get();
+            if (featureNameLength == 0) {
+                break;
+            }
+            final byte[] featureNameBytes = new byte[featureNameLength];
+            buf.get(featureNameBytes);
+            buf.getInt(); // feature value
+        }
+
+        final int bucketCount = this.gridSize * this.gridSize;
+        final int[] bucketSizes = new int[bucketCount];
+        final byte[] bucketCompressionLevels = new byte[bucketCount];
+        final long[] bucketHashes = new long[bucketCount];
+        for (int i = 0; i < bucketCount; i++) {
+            bucketSizes[i] = buf.getInt();
+            bucketCompressionLevels[i] = buf.get();
+            bucketHashes[i] = buf.getLong();
+        }
+
+        this.bucketBuffers = new byte[bucketCount][];
+        for (int i = 0; i < bucketCount; i++) {
+            if (bucketSizes[i] > 0) {
+                this.bucketBuffers[i] = new byte[bucketSizes[i]];
+                buf.get(this.bucketBuffers[i]);
+                final long rawHash = LinearHash.xxhash64(this.bucketBuffers[i]);
+                if (rawHash != bucketHashes[i]) {
+                    throw new IOException("Region file hash incorrect " + this.regionFile);
+                }
+            }
+        }
+
+        final long footerSuperBlock = buf.getLong();
+        if (footerSuperBlock != SUPERBLOCK) {
+            throw new IOException("Footer superblock invalid " + this.regionFile);
+        }
+    }
+
+    private void markToSave() {
+        synchronized (this.markedToSaveLock) {
+            this.markedToSave = true;
+        }
+    }
+
+    private boolean isMarkedToSave() {
+        synchronized (this.markedToSaveLock) {
+            if (this.markedToSave) {
+                this.markedToSave = false;
+                return true;
+            }
+            return false;
+        }
+    }
+
+    public synchronized boolean doesChunkExist(final ChunkPos pos) throws Exception {
+        this.openRegionFile();
+        this.openBucket(pos.x(), pos.z());
+        return this.bufferUncompressedSize[getChunkIndex(pos.x(), pos.z())] > 0;
+    }
+
+    @Override
+    public synchronized void flush() throws IOException {
+        if (!this.isMarkedToSave()) {
+            return;
+        }
+
+        this.openRegionFile();
+
+        final long timestamp = getTimestamp();
+        final File tempFile = new File(this.regionFile.toString() + ".tmp");
+        final FileOutputStream fileStream = new FileOutputStream(tempFile);
+        final DataOutputStream dataStream = new DataOutputStream(fileStream);
+
+        dataStream.writeLong(SUPERBLOCK);
+        dataStream.writeByte(VERSION);
+        dataStream.writeLong(timestamp);
+        dataStream.writeByte(this.gridSize);
+
+        final String fileName = this.regionFile.getFileName().toString();
+        final String[] parts = fileName.split("\\.");
+        int regionX = 0;
+        int regionZ = 0;
+        try {
+            if (parts.length >= 3) {
+                regionX = Integer.parseInt(parts[1]);
+                regionZ = Integer.parseInt(parts[2]);
+            } else {
+                LOGGER.warn("Unexpected file name format: {}", fileName);
+            }
+        } catch (final NumberFormatException e) {
+            LOGGER.error("Failed to parse region coordinates from file name: {}", fileName, e);
+        }
+
+        dataStream.writeInt(regionX);
+        dataStream.writeInt(regionZ);
+
+        final boolean[] chunkExistenceBitmap = new boolean[1024];
+        for (int i = 0; i < 1024; i++) {
+            chunkExistenceBitmap[i] = (this.bufferUncompressedSize[i] > 0);
+        }
+        this.writeSerializedExistenceBitmap(dataStream, chunkExistenceBitmap);
+
+        this.writeNBTFeatures(dataStream);
+
+        final int bucketCount = this.gridSize * this.gridSize;
+        final byte[][] buckets = new byte[bucketCount][];
+        for (int bx = 0; bx < this.gridSize; bx++) {
+            for (int bz = 0; bz < this.gridSize; bz++) {
+                final int bucketIdx = bx * this.gridSize + bz;
+                if (this.bucketBuffers != null && this.bucketBuffers[bucketIdx] != null) {
+                    buckets[bucketIdx] = this.bucketBuffers[bucketIdx];
+                    continue;
+                }
+
+                final ByteArrayOutputStream bucketStream = new ByteArrayOutputStream();
+                final ZstdOutputStream zstdStream = new ZstdOutputStream(bucketStream, this.compressionLevel);
+                final DataOutputStream bucketDataStream = new DataOutputStream(zstdStream);
+
+                for (int cx = 0; cx < 32 / this.gridSize; cx++) {
+                    for (int cz = 0; cz < 32 / this.gridSize; cz++) {
+                        final int chunkIndex = (bx * (32 / this.gridSize) + cx) + (bz * (32 / this.gridSize) + cz) * 32;
+                        if (this.bufferUncompressedSize[chunkIndex] > 0) {
+                            final byte[] chunkData = new byte[this.bufferUncompressedSize[chunkIndex]];
+                            this.decompressor.decompress(this.buffer[chunkIndex], 0, chunkData, 0, this.bufferUncompressedSize[chunkIndex]);
+                            bucketDataStream.writeInt(chunkData.length + 8);
+                            bucketDataStream.writeLong(this.chunkTimestamps[chunkIndex]);
+                            bucketDataStream.write(chunkData);
+                        } else {
+                            bucketDataStream.writeInt(0);
+                            bucketDataStream.writeLong(this.chunkTimestamps[chunkIndex]);
+                        }
+                    }
+                }
+                bucketDataStream.close();
+                buckets[bucketIdx] = bucketStream.toByteArray();
+            }
+        }
+
+        for (int i = 0; i < bucketCount; i++) {
+            dataStream.writeInt(buckets[i] != null ? buckets[i].length : 0);
+            dataStream.writeByte(this.compressionLevel);
+            long rawHash = 0;
+            if (buckets[i] != null) {
+                rawHash = LinearHash.xxhash64(buckets[i]);
+            }
+            dataStream.writeLong(rawHash);
+        }
+
+        for (int i = 0; i < bucketCount; i++) {
+            if (buckets[i] != null) {
+                dataStream.write(buckets[i]);
+            }
+        }
+
+        dataStream.writeLong(SUPERBLOCK);
+
+        dataStream.flush();
+        fileStream.getFD().sync();
+        fileStream.getChannel().force(true);
+        dataStream.close();
+        fileStream.close();
+
+        Files.move(tempFile.toPath(), this.regionFile, StandardCopyOption.REPLACE_EXISTING);
+    }
+
+    private void writeNBTFeatures(final DataOutputStream dataStream) throws IOException {
+        dataStream.writeByte(0); // End of NBT features
+    }
+
+    public static final int MAX_CHUNK_SIZE = 500 * 1024 * 1024;
+
+    @Override
+    public synchronized void write(final ChunkPos pos, final ByteBuffer buffer) {
+        this.openRegionFile();
+        this.openBucket(pos.x(), pos.z());
+        try {
+            final byte[] b;
+            if (buffer.hasArray()) {
+                b = new byte[buffer.remaining()];
+                System.arraycopy(buffer.array(), buffer.arrayOffset() + buffer.position(), b, 0, buffer.remaining());
+            } else {
+                b = new byte[buffer.remaining()];
+                buffer.get(b);
+            }
+            final int uncompressedSize = b.length;
+
+            if (uncompressedSize > MAX_CHUNK_SIZE) {
+                LOGGER.error("Chunk dupe attempt {}", this.regionFile);
+                this.clear(pos);
+            } else {
