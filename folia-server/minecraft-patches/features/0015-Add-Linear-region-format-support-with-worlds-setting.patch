+package io.papermc.paper.linear;
+
+public enum RegionFormat {
+    MCA("mca", ".mca"),
+    LINEAR("linear", ".linear");
+
+    private final String configName;
+    private final String extension;
+
+    RegionFormat(final String configName, final String extension) {
+        this.configName = configName;
+        this.extension = extension;
+    }
+
+    public String configName() {
+        return this.configName;
+    }
+
+    public String extension() {
+        return this.extension;
+    }
+
+    public static RegionFormat fromString(final String name) {
+        if (name == null) {
+            return MCA;
+        }
+        for (final RegionFormat format : values()) {
+            if (format.configName.equalsIgnoreCase(name) || format.name().equalsIgnoreCase(name)) {
+                return format;
+            }
+        }
+        throw new IllegalArgumentException("Unknown region format: '" + name + "'. Supported formats: MCA, LINEAR");
+    }
+}
