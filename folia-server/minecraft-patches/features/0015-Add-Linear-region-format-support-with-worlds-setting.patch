+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+import java.util.stream.Stream;
+
+/**
+ * World region format conversion pipeline:
+ * - Detects required conversions across all world dimensions and subfolders (region, entities, poi)
+ * - Aborts with detailed message if conversion needed but automatic is false
+ * - Displays 30s countdown (configurable) with clean cancellation
+ * - Takes full world backup before conversion (non-recursive)
+ * - Converts MCA <-> Linear with verification (re-read & NBT comparison) and crash-recovery state tracking
+ */
+public final class WorldFormatConverter {
+    private static final Logger LOGGER = LogUtils.getLogger();
+    private static final Pattern REGION_FILE_PATTERN = Pattern.compile("^r\\.(-?[0-9]+)\\.(-?[0-9]+)\\.(mca|linear)$");
+    private static final String CONVERSION_STATE_FILE = ".conversion-state";
+
+    public record WorldFolderTarget(
+        String worldName,
+        Path worldDir,
+        WorldsSettings.WorldFormatSetting setting
+    ) {}
+
+    public record ConversionTask(
+        String worldName,
+        Path worldDir,
+        Path subFolder,
+        String folderType,
+        RegionFormat sourceFormat,
+        RegionFormat targetFormat,
+        int targetCompression,
+        WorldsSettings.WorldFormatSetting setting,
+        List<Path> filesToConvert
+    ) {}
+
+    private WorldFormatConverter() {}
+
+    public static void runStartupCheck(final MinecraftServer server) {
+        final WorldsSettings settings = WorldsSettings.get();
+        if (settings == null) {
+            return;
+        }
+
+        // Collect all dimension folders for all configured stems
+        final List<WorldFolderTarget> targets = discoverWorldTargets(server, settings);
+
+        // Scan for required conversions
+        final List<ConversionTask> tasks = new ArrayList<>();
+        final List<ConversionTask> unapprovedTasks = new ArrayList<>();
+
+        for (final WorldFolderTarget target : targets) {
+            final List<ConversionTask> worldTasks = findConversionTasks(target);
+            for (final ConversionTask task : worldTasks) {
+                if (task.setting().conversion().automatic()) {
+                    tasks.add(task);
+                } else {
+                    unapprovedTasks.add(task);
+                }
+            }
+        }
+
+        // Check if there are conversions needed but automatic is disabled
+        if (!unapprovedTasks.isEmpty()) {
+            final StringBuilder sb = new StringBuilder();
+            sb.append("\n======================================================================\n");
+            sb.append(" [!] FORMAT CONVERSION REQUIRED BUT AUTOMATIC CONVERSION IS DISABLED!\n");
+            sb.append("======================================================================\n");
+            sb.append("The following worlds have files in a format different from configured target format:\n");
+            for (final ConversionTask t : unapprovedTasks) {
+                sb.append(String.format(" - World: %s | Folder: %s | Source: %s -> Target: %s (%d files)\n",
+                    t.worldName(), t.subFolder().getFileName(), t.sourceFormat(), t.targetFormat(), t.filesToConvert().size()));
+            }
+            sb.append("\nTo allow automatic conversion, enable it in config/worlds-settings.yml:\n");
+            sb.append("defaults:\n  conversion:\n    automatic: true\n");
+            sb.append("Or enable it specifically per world under 'worlds'.\n");
+            sb.append("The server will now shut down to prevent data corruption.\n");
+            sb.append("======================================================================\n");
+            LOGGER.error(sb.toString());
+            throw new IllegalStateException("Format conversion required but automatic conversion is disabled in worlds-settings.yml");
+        }
+
+        if (tasks.isEmpty()) {
+            return;
+        }
+
+        // We have tasks to execute
+        executeConversionPipeline(tasks);
+    }
+
+    private static final Object FOLDER_CONVERSION_LOCK = new Object();
+    private static final Set<Path> CHECKED_FOLDERS = Collections.synchronizedSet(new HashSet<>());
+
+    public static void checkAndConvertFolder(final Path folder, final WorldsSettings settings) {
+        if (folder == null || !Files.isDirectory(folder)) {
+            return;
+        }
+        final Path normalized = folder.toAbsolutePath().normalize();
+        if (CHECKED_FOLDERS.contains(normalized)) {
+            return;
+        }
+
+        synchronized (FOLDER_CONVERSION_LOCK) {
+            if (CHECKED_FOLDERS.contains(normalized)) {
+                return;
+            }
+
+            final WorldsSettings.WorldFormatSetting setting = settings.getForPath(folder);
+            final RegionFormat targetFormat = setting.regionFormat();
+            final String otherExt = targetFormat == RegionFormat.LINEAR ? ".mca" : ".linear";
+            final RegionFormat sourceFormat = targetFormat == RegionFormat.LINEAR ? RegionFormat.MCA : RegionFormat.LINEAR;
+
+            final List<Path> filesToConvert = new ArrayList<>();
+            try (final Stream<Path> stream = Files.list(folder)) {
+                stream.forEach(file -> {
+                    final String name = file.getFileName().toString();
+                    if (name.startsWith("r.") && name.endsWith(otherExt)) {
+                        filesToConvert.add(file);
+                    }
+                });
+            } catch (final IOException ex) {
+                LOGGER.error("Failed to list files in {}", folder.toAbsolutePath(), ex);
+                return;
+            }
+
+            if (filesToConvert.isEmpty()) {
+                CHECKED_FOLDERS.add(normalized);
+                return;
+            }
+
+            // Conversion is required
+            final Path worldDir = folder.getParent() != null ? folder.getParent() : folder;
+            final String worldName = worldDir.getFileName() != null ? worldDir.getFileName().toString() : "unknown";
+
+            if (!setting.conversion().automatic()) {
+                final String msg = String.format(
+                    "World folder '%s' (subfolder '%s') contains %d files in %s format, but target format is %s and automatic conversion is disabled in worlds-settings.yml! Operation halted.",
+                    worldName, folder.getFileName(), filesToConvert.size(), sourceFormat, targetFormat
+                );
+                LOGGER.error(msg);
+                throw new IllegalStateException(msg);
+            }
+
+            LOGGER.warn("Dynamic folder conversion triggered for '{}' ({}) from {} to {} ({} files)...",
+                worldName, folder.getFileName(), sourceFormat, targetFormat, filesToConvert.size());
+
+            final ConversionTask task = new ConversionTask(
+                worldName,
+                worldDir,
+                folder,
+                folder.getFileName().toString(),
+                sourceFormat,
+                targetFormat,
+                setting.linearCompressionLevel(),
+                setting,
+                filesToConvert
+            );
+
+            executeConversionPipeline(List.of(task));
+
+            CHECKED_FOLDERS.add(normalized);
+            LOGGER.info("Dynamic conversion completed for '{}' ({}).", worldName, folder.getFileName());
+        }
+    }
+
+
+    private static List<WorldFolderTarget> discoverWorldTargets(final MinecraftServer server, final WorldsSettings settings) {
+        final List<WorldFolderTarget> result = new ArrayList<>();
+        final LevelStorageSource.LevelStorageAccess storageSource = server.storageSource;
+        final Registry<LevelStem> levelStemRegistry = server.registryAccess().lookupOrThrow(Registries.LEVEL_STEM);
+
+        final Set<Path> visitedPaths = new HashSet<>();
+
+        for (final LevelStem stem : levelStemRegistry) {
+            final ResourceKey<LevelStem> stemKey = server.registryAccess().lookupOrThrow(Registries.LEVEL_STEM).getResourceKey(stem).orElse(null);
+            if (stemKey == null) continue;
+
+            final ResourceKey<Level> dimKey = Registries.levelStemToLevel(stemKey);
+            final Path dimPath = storageSource.getDimensionPath(dimKey);
+            if (dimPath == null || !Files.isDirectory(dimPath)) continue;
+
+            final Path normalized = dimPath.toAbsolutePath().normalize();
+            if (visitedPaths.add(normalized)) {
+                final String worldName = dimPath.getFileName().toString();
+                final WorldsSettings.WorldFormatSetting setting = settings.getForWorld(worldName);
+                result.add(new WorldFolderTarget(worldName, dimPath, setting));
+            }
+        }
+
+        // Also check root world folder
+        final Path rootWorld = storageSource.getDimensionPath(Level.OVERWORLD);
+        if (rootWorld != null && Files.isDirectory(rootWorld)) {
+            final Path normRoot = rootWorld.toAbsolutePath().normalize();
+            if (visitedPaths.add(normRoot)) {
+                final String rootName = rootWorld.getFileName().toString();
+                final WorldsSettings.WorldFormatSetting setting = settings.getForWorld(rootName);
+                result.add(new WorldFolderTarget(rootName, rootWorld, setting));
+            }
+        }
+
+        return result;
+    }
+
+    private static List<ConversionTask> findConversionTasks(final WorldFolderTarget target) {
+        final List<ConversionTask> tasks = new ArrayList<>();
+        final String[] subFolders = {"region", "entities", "poi"};
+        final RegionFormat targetFormat = target.setting().regionFormat();
+        final String targetExt = targetFormat.extension();
+        final String otherExt = targetFormat == RegionFormat.LINEAR ? ".mca" : ".linear";
+        final RegionFormat sourceFormat = targetFormat == RegionFormat.LINEAR ? RegionFormat.MCA : RegionFormat.LINEAR;
+
+        for (final String sub : subFolders) {
+            final Path subPath = target.worldDir().resolve(sub);
+            if (!Files.isDirectory(subPath)) {
+                continue;
+            }
+
+            final List<Path> filesToConvert = new ArrayList<>();
+            try (final Stream<Path> stream = Files.list(subPath)) {
+                stream.forEach(file -> {
+                    final String name = file.getFileName().toString();
+                    if (name.startsWith("r.") && name.endsWith(otherExt)) {
+                        filesToConvert.add(file);
+                    }
+                });
+            } catch (final IOException ex) {
+                LOGGER.error("Failed to list files in {}", subPath.toAbsolutePath(), ex);
+            }
+
+            if (!filesToConvert.isEmpty()) {
+                tasks.add(new ConversionTask(
+                    target.worldName(),
+                    target.worldDir(),
+                    subPath,
+                    sub,
+                    sourceFormat,
+                    targetFormat,
+                    target.setting().linearCompressionLevel(),
+                    target.setting(),
+                    filesToConvert
+                ));
+            }
+        }
+
+        return tasks;
+    }
+
+    private static void executeConversionPipeline(final List<ConversionTask> tasks) {
+        final StringBuilder warning = new StringBuilder();
+        warning.append("\n======================================================================\n");
+        warning.append(" [!] WORLD FORMAT CONVERSION SCHEDULED\n");
+        warning.append("======================================================================\n");
+        warning.append("The following worlds and folders will be converted:\n");
+
+        final Set<Path> worldsToBackup = new LinkedHashSet<>();
+        int totalFiles = 0;
+        int maxCountdown = 0;
+
+        for (final ConversionTask task : tasks) {
+            warning.append(String.format(" - World: %s | Folder: %s | %s -> %s (%d files)\n",
+                task.worldName(), task.subFolder().getFileName(), task.sourceFormat(), task.targetFormat(), task.filesToConvert().size()));
+            worldsToBackup.add(task.worldDir());
+            totalFiles += task.filesToConvert().size();
+            maxCountdown = Math.max(maxCountdown, task.setting().conversion().countdownSeconds());
+        }
+
+        warning.append(String.format("Total files to convert: %d\n", totalFiles));
+
+        final boolean anyBackup = tasks.stream().anyMatch(t -> t.setting().conversion().backupEnabled());
+        final String backupDir = tasks.stream().map(t -> t.setting().conversion().backupDirectory()).findFirst().orElse("backups/world-conversion");
+
+        if (anyBackup) {
+            warning.append(String.format("Backup: ENABLED (directory: %s)\n", backupDir));
+        } else {
+            warning.append("Backup: [!] DISABLED (No backup will be created!)\n");
+        }
+        warning.append("======================================================================\n");
+        LOGGER.warn(warning.toString());
+
+        // Countdown with interrupt support
+        if (maxCountdown > 0) {
+            runCountdown(maxCountdown);
+        }
+
+        // Perform backups
+        for (final Path worldDir : worldsToBackup) {
+            final ConversionTask repTask = tasks.stream().filter(t -> t.worldDir().equals(worldDir)).findFirst().orElse(null);
+            if (repTask != null && repTask.setting().conversion().backupEnabled()) {
+                performBackup(worldDir, repTask.setting().conversion().backupDirectory());
+            }
+        }
+
+        // Perform conversions
+        LOGGER.info("Starting format conversion of {} files...", totalFiles);
+        final long startMs = System.currentTimeMillis();
+        int convertedFiles = 0;
+
+        for (final ConversionTask task : tasks) {
+            LOGGER.info("Converting {}/{} ({} -> {})...", task.worldName(), task.subFolder().getFileName(), task.sourceFormat(), task.targetFormat());
+            final Path stateFile = task.subFolder().resolve(CONVERSION_STATE_FILE);
+
+            for (final Path srcFile : task.filesToConvert()) {
+                convertSingleFile(srcFile, task.targetFormat(), task.targetCompression(), stateFile);
+                convertedFiles++;
+                LOGGER.info("Progress: {}/{} files converted ({})", convertedFiles, totalFiles, srcFile.getFileName());
+            }
+
+            try {
+                Files.deleteIfExists(stateFile);
+            } catch (final IOException ignored) {}
+        }
+
+        final long elapsed = System.currentTimeMillis() - startMs;
+        LOGGER.info("======================================================================");
+        LOGGER.info("Format conversion completed successfully: {} files in {} ms.", convertedFiles, elapsed);
+        LOGGER.info("======================================================================");
+    }
+
+    private static void runCountdown(final int seconds) {
+        final AtomicBoolean cancelled = new AtomicBoolean(false);
+        final Thread mainThread = Thread.currentThread();
+
+        final Thread shutdownHook = new Thread(() -> {
+            cancelled.set(true);
+            mainThread.interrupt();
+        }, "Conversion-Shutdown-Watcher");
+
+        Runtime.getRuntime().addShutdownHook(shutdownHook);
+
+        try {
+            for (int i = seconds; i > 0; i--) {
+                if (cancelled.get()) {
+                    LOGGER.warn("Conversion aborted by shutdown request.");
+                    throw new RuntimeException("Conversion aborted by user.");
+                }
+                if (i == seconds || i == 20 || i == 10 || i <= 5) {
+                    LOGGER.warn("Conversion will begin in {} seconds... Press Ctrl+C to cancel.", i);
+                }
+                Thread.sleep(1000);
+            }
+        } catch (final InterruptedException e) {
+            LOGGER.warn("Conversion aborted during countdown.");
+            throw new RuntimeException("Conversion aborted by user.", e);
+        } finally {
+            try {
+                Runtime.getRuntime().removeShutdownHook(shutdownHook);
+            } catch (final IllegalStateException ignored) {}
+        }
+    }
+
+    private static void performBackup(final Path worldDir, final String backupDirPath) {
+        final String timestamp = LocalDateTime.now().format(DateTimeFormatter.ofPattern("yyyy-MM-dd_HH-mm-ss"));
+        final String worldName = worldDir.getFileName().toString();
+        final Path targetBase = Paths.get(backupDirPath);
+        final Path backupTarget = targetBase.resolve(worldName + "_" + timestamp);
+
+        // Prevent recursive backup: verify backupTarget is not inside worldDir
+        try {
+            final Path worldAbs = worldDir.toRealPath();
+            final Path targetAbs = backupTarget.toAbsolutePath().normalize();
+            if (targetAbs.startsWith(worldAbs)) {
+                throw new IllegalStateException("Backup target directory (" + targetAbs + ") cannot be inside the world folder (" + worldAbs + ")");
+            }
+
+            LOGGER.info("Creating backup of '{}' to '{}'...", worldName, backupTarget.toAbsolutePath());
+            Files.createDirectories(backupTarget);
+
+            Files.walkFileTree(worldDir, new SimpleFileVisitor<>() {
+                @Override
+                public FileVisitResult preVisitDirectory(final Path dir, final BasicFileAttributes attrs) throws IOException {
+                    final Path rel = worldDir.relativize(dir);
+                    final Path dest = backupTarget.resolve(rel);
+                    Files.createDirectories(dest);
+                    return FileVisitResult.CONTINUE;
+                }
+
+                @Override
+                public FileVisitResult visitFile(final Path file, final BasicFileAttributes attrs) throws IOException {
+                    final Path rel = worldDir.relativize(file);
+                    final Path dest = backupTarget.resolve(rel);
+                    Files.copy(file, dest, StandardCopyOption.COPY_ATTRIBUTES);
+                    return FileVisitResult.CONTINUE;
+                }
+            });
+
+            LOGGER.info("Backup of '{}' completed successfully.", worldName);
+        } catch (final IOException ex) {
+            LOGGER.error("Backup failed for world '{}'. Conversion halted to prevent data loss!", worldName, ex);
+            throw new RuntimeException("Backup failed: " + ex.getMessage(), ex);
+        }
+    }
+
+    private static void convertSingleFile(final Path srcFile, final RegionFormat targetFormat, final int targetCompression, final Path stateFile) {
+        final String srcName = srcFile.getFileName().toString();
+        final Matcher matcher = REGION_FILE_PATTERN.matcher(srcName);
+        if (!matcher.matches()) {
+            return;
+        }
+
+        final int regX = Integer.parseInt(matcher.group(1));
+        final int regZ = Integer.parseInt(matcher.group(2));
+        final String targetName = "r." + regX + "." + regZ + targetFormat.extension();
+        final Path dstFile = srcFile.resolveSibling(targetName);
+        final Path tempDstFile = srcFile.resolveSibling(targetName + ".tmp");
+
+        // Write state file before processing
+        try {
+            Files.writeString(stateFile, srcName + " -> " + targetName + "\n", StandardOpenOption.CREATE, StandardOpenOption.WRITE);
+        } catch (final IOException ignored) {}
+
+        try {
+            // Read all chunks from source file
+            final Map<ChunkPos, CompoundTag> loadedChunks = new HashMap<>();
+            final RegionStorageInfo info = new RegionStorageInfo("conversion", Level.OVERWORLD, "chunk");
+
+            if (srcName.endsWith(".mca")) {
+                try (final RegionFile mca = new RegionFile(info, srcFile, srcFile.getParent(), true)) {
+                    for (int x = 0; x < 32; x++) {
+                        for (int z = 0; z < 32; z++) {
+                            final ChunkPos pos = new ChunkPos((regX << 5) + x, (regZ << 5) + z);
+                            if (mca.hasChunk(pos)) {
+                                try (final DataInputStream in = mca.getChunkDataInputStream(pos)) {
+                                    if (in != null) {
+                                        final CompoundTag tag = NbtIo.read(in);
+                                        if (tag != null) {
+                                            loadedChunks.put(pos, tag);
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            } else if (srcName.endsWith(".linear")) {
+                try (final LinearRegionFile linear = new LinearRegionFile(info, srcFile, srcFile.getParent(), true, targetCompression)) {
+                    for (int x = 0; x < 32; x++) {
+                        for (int z = 0; z < 32; z++) {
+                            final ChunkPos pos = new ChunkPos((regX << 5) + x, (regZ << 5) + z);
+                            if (linear.hasChunk(pos)) {
+                                try (final DataInputStream in = linear.getChunkDataInputStream(pos)) {
+                                    if (in != null) {
+                                        final CompoundTag tag = NbtIo.read(in);
+                                        if (tag != null) {
+                                            loadedChunks.put(pos, tag);
+                                        }
+                                    }
+                                }
+                            }
+                        }
+                    }
+                }
+            }
+
+            // Write all loaded chunks into temp destination file
+            Files.deleteIfExists(tempDstFile);
+
+            if (targetFormat == RegionFormat.LINEAR) {
+                try (final LinearRegionFile dstLinear = new LinearRegionFile(info, tempDstFile, tempDstFile.getParent(), true, targetCompression)) {
+                    for (final Map.Entry<ChunkPos, CompoundTag> entry : loadedChunks.entrySet()) {
+                        try (final DataOutputStream out = dstLinear.getChunkDataOutputStream(entry.getKey())) {
+                            NbtIo.write(entry.getValue(), out);
+                        }
+                    }
+                    dstLinear.flush();
+                }
+            } else {
+                try (final RegionFile dstMca = new RegionFile(info, tempDstFile, tempDstFile.getParent(), true)) {
+                    for (final Map.Entry<ChunkPos, CompoundTag> entry : loadedChunks.entrySet()) {
+                        try (final DataOutputStream out = dstMca.getChunkDataOutputStream(entry.getKey())) {
+                            NbtIo.write(entry.getValue(), out);
+                        }
+                    }
+                    dstMca.flush();
+                }
+            }
+
+            // Verification: re-read temp file and compare decoded NBT tags
+            verifyConvertedFile(tempDstFile, targetFormat, targetCompression, loadedChunks, regX, regZ);
+
+            // Verified! Atomic replace
+            Files.move(tempDstFile, dstFile, StandardCopyOption.REPLACE_EXISTING);
+
+            // Only delete source file after dstFile is safely placed
+            Files.deleteIfExists(srcFile);
+
+        } catch (final Exception ex) {
+            LOGGER.error("Failed to convert file {}", srcFile.toAbsolutePath(), ex);
+            try {
+                Files.deleteIfExists(tempDstFile);
+            } catch (final IOException ignored) {}
+            throw new RuntimeException("Conversion failed for file " + srcFile.getFileName() + ": " + ex.getMessage(), ex);
+        }
+    }
+
+    private static void verifyConvertedFile(final Path file, final RegionFormat format, final int compression,
+                                            final Map<ChunkPos, CompoundTag> originalChunks, final int regX, final int regZ) throws Exception {
+        final RegionStorageInfo info = new RegionStorageInfo("verify", Level.OVERWORLD, "chunk");
+
+        if (format == RegionFormat.LINEAR) {
+            try (final LinearRegionFile linear = new LinearRegionFile(info, file, file.getParent(), true, compression)) {
+                for (final Map.Entry<ChunkPos, CompoundTag> entry : originalChunks.entrySet()) {
+                    final ChunkPos pos = entry.getKey();
+                    if (!linear.hasChunk(pos)) {
+                        throw new IllegalStateException("Verification failed: chunk " + pos + " missing in converted linear file");
+                    }
+                    try (final DataInputStream in = linear.getChunkDataInputStream(pos)) {
+                        if (in == null) {
+                            throw new IllegalStateException("Verification failed: input stream null for chunk " + pos);
+                        }
+                        final CompoundTag readTag = NbtIo.read(in);
+                        if (!entry.getValue().equals(readTag)) {
+                            throw new IllegalStateException("Verification failed: NBT content mismatch for chunk " + pos);
+                        }
+                    }
+                }
+            }
+        } else {
+            try (final RegionFile mca = new RegionFile(info, file, file.getParent(), true)) {
+                for (final Map.Entry<ChunkPos, CompoundTag> entry : originalChunks.entrySet()) {
+                    final ChunkPos pos = entry.getKey();
+                    if (!mca.hasChunk(pos)) {
+                        throw new IllegalStateException("Verification failed: chunk " + pos + " missing in converted mca file");
+                    }
+                    try (final DataInputStream in = mca.getChunkDataInputStream(pos)) {
+                        if (in == null) {
+                            throw new IllegalStateException("Verification failed: input stream null for chunk " + pos);
+                        }
+                        final CompoundTag readTag = NbtIo.read(in);
+                        if (!entry.getValue().equals(readTag)) {
+                            throw new IllegalStateException("Verification failed: NBT content mismatch for chunk " + pos);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
